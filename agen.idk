impor datetime
impor json
impor re
impor urllib.request
dari pathlib impor Path
dari typing impor Any, Callable, Optional
dari google impor genai
dari google.genai impor types

dari konfigurasi impor pengelola_konfigurasi
dari logger impor agent_logger
dari memori impor pengelola_memori
dari pengelola_sesi impor pengelola_sesi, Sesi, PesanSesi
dari perkakas impor ALAT_TERSEDIA, DAFTAR_PANGGILAN_ALAT, SKEMA_ALAT_OPENAI


fungsi _buat_http_options() {
    """Membuat HttpOptions jika konfigurasi GEMINI_BASE_URL (misal: Omniroute) disetel."""
    base_url = pengelola_konfigurasi.ambil_base_url()
    jika base_url {
        url_bersih = base_url.rstrip("/")
        jika url_bersih.endswith("/v1") {
            url_bersih = url_bersih[:-3]
        }
        kembalikan types.HttpOptions(base_url=url_bersih)
    }
    kembalikan kosong
}


fungsi pindai_model_omniroute(base_url, api_key) {
    """Memindai model aktif yang tersedia di Omniroute melalui endpoint /v1/models."""
    coba {
        clean = base_url.rstrip("/")
        jika clean.endswith("/v1") {
            clean = clean[:-3]
        }
        target_url = clean + "/v1/models"
        req = urllib.request.Request(target_url, headers={"Authorization": f"Bearer {api_key}"})
        dengan urllib.request.urlopen(req, timeout=5) sebagai resp {
            data = json.loads(resp.read().decode())
            models = [
                {
                    "id": "auto",
                    "raw_name": "auto",
                    "display_name": "Omniroute Auto (Rekomendasi)",
                    "description": "Otomatis memilih model terbaik di Omniroute.",
                    "input_token_limit": 1000000,
                    "output_token_limit": 65535,
                }
            ]
            untuk m dalam data.get("data", []) {
                m_id = m.get("id", "")
                jika tidak m_id atau m_id == "auto" {
                    lewati
                }
                name = m.get("name") atau m_id
                desc = f"Provider: {m.get('owned_by', 'omniroute')}"
                models.append({
                    "id": m_id,
                    "raw_name": m_id,
                    "display_name": name,
                    "description": desc,
                    "input_token_limit": m.get("max_input_tokens") atau 1000000,
                    "output_token_limit": m.get("max_output_tokens") atau 65535,
                })
            }
            kembalikan models
        }
    } kecuali exc {
        agent_logger.log_error("agen.pindai_model_omniroute", f"Gagal memindai model Omniroute: {exc}")
        kembalikan [
            {
                "id": "auto",
                "raw_name": "auto",
                "display_name": "Omniroute Auto (Rekomendasi)",
                "description": "Otomatis memilih model terbaik di Omniroute.",
                "input_token_limit": 1000000,
                "output_token_limit": 65535,
            },
            {
                "id": "auto/best-coding",
                "raw_name": "auto/best-coding",
                "display_name": "Omniroute Best Coding",
                "description": "Rute model koding terbaik di Omniroute.",
                "input_token_limit": 1000000,
                "output_token_limit": 65535,
            },
            {
                "id": "auto/best-fast",
                "raw_name": "auto/best-fast",
                "display_name": "Omniroute Best Fast",
                "description": "Rute model cepat di Omniroute.",
                "input_token_limit": 1000000,
                "output_token_limit": 65535,
            },
            {
                "id": "auto/gemini",
                "raw_name": "auto/gemini",
                "display_name": "Omniroute Auto Gemini",
                "description": "Rute model Gemini di Omniroute.",
                "input_token_limit": 1000000,
                "output_token_limit": 65535,
            },
        ]
    }
}


fungsi pindai_model_tersedia(api_key=kosong) {
    """Mendapatkan daftar model yang kompatibel secara dinamis sesuai provider aktif."""
    provider = pengelola_konfigurasi.ambil_provider()
    jika provider == "groq" {
        kembalikan [
            {
                "id": "openai/gpt-oss-120b",
                "raw_name": "openai/gpt-oss-120b",
                "display_name": "OpenAI GPT OSS 120B (Terbesar & Cerdas ⚡)",
                "description": "Model 120B OpenAI generasi terbaru di Groq, sangat cerdas & respons ~0.8s.",
                "input_token_limit": 131072,
                "output_token_limit": 65536,
            },
            {
                "id": "openai/gpt-oss-20b",
                "raw_name": "openai/gpt-oss-20b",
                "display_name": "OpenAI GPT OSS 20B (Ultra Fast ~0.4s)",
                "description": "Model 20B OpenAI berkecepatan tinggi dan pintar di Groq LPU.",
                "input_token_limit": 131072,
                "output_token_limit": 65536,
            },
            {
                "id": "qwen/qwen3.8-27b",
                "raw_name": "qwen/qwen3.8-27b",
                "display_name": "Qwen 3.8 27B (Alibaba Cloud)",
                "description": "Model Qwen 27B handal untuk penalaran dan instruksi teks.",
                "input_token_limit": 131072,
                "output_token_limit": 16384,
            },
            {
                "id": "llama-3.3-70b-versatile",
                "raw_name": "llama-3.3-70b-versatile",
                "display_name": "Llama 3.3 70B Versatile",
                "description": "Model 70B Meta Llama 3.3 di Groq.",
                "input_token_limit": 128000,
                "output_token_limit": 32768,
            },
        ]
    }
    jika provider == "omniroute" {
        kunci_omni = api_key atau pengelola_konfigurasi.ambil_omni_api_key() atau ""
        base_url = pengelola_konfigurasi.ambil_omni_base_url()
        kembalikan pindai_model_omniroute(base_url, kunci_omni)
    }

    kunci_bersih = (api_key atau pengelola_konfigurasi.ambil_gemini_api_key() atau "").strip()
    http_opts = _buat_http_options()
    klien = genai.Client(api_key=kunci_bersih, http_options=http_opts) jika http_opts selain genai.Client(api_key=kunci_bersih)
    model_tersaring = []

    coba {
        daftar_model = klien.models.list()
        untuk m dalam daftar_model {
            nama_asli = getattr(m, "name", "")
            id_bersih = nama_asli.replace("models/", "") jika nama_asli.startswith("models/") selain nama_asli
            nama_tampil = getattr(m, "display_name", "") atau id_bersih
            deskripsi = getattr(m, "description", "") atau "Model resmi Gemini dari Google."
            aksi = getattr(m, "supported_actions", []) atau []

            apakah_generate = salah
            jika aksi {
                apakah_generate = any(["generatecontent" dalam str(act).lower() untuk act dalam aksi])
            } selain {
                apakah_generate = "gemini" dalam id_bersih.lower()
            }

            kata_diabaikan = ["embedding", "imagen", "aqa", "text-bison", "chat-bison"]
            jika any([ign dalam id_bersih.lower() untuk ign dalam kata_diabaikan]) {
                lewati
            }

            jika apakah_generate {
                model_tersaring.append({
                    "id": id_bersih,
                    "raw_name": nama_asli,
                    "display_name": nama_tampil,
                    "description": deskripsi.strip(),
                    "input_token_limit": getattr(m, "input_token_limit", kosong),
                    "output_token_limit": getattr(m, "output_token_limit", kosong),
                })
            }
        }

        fungsi _prioritas_model(x) {
            kembalikan (
                0 jika "3" dalam x["id"] dan "flash" dalam x["id"].lower() selain (
                    1 jika "flash" dalam x["id"].lower() selain (
                        2 jika "3" dalam x["id"] selain 3
                    )
                ),
                x["id"].lower(),
            )
        }
        jika tidak model_tersaring {
            model_tersaring = [
                {
                    "id": "gemini-2.5-flash",
                    "raw_name": "gemini-2.5-flash",
                    "display_name": "Gemini 2.5 Flash",
                    "description": "Model cepat dan efisien bawaan Gemini.",
                    "input_token_limit": 1048576,
                    "output_token_limit": 8192,
                },
                {
                    "id": "gemini-3-flash-preview",
                    "raw_name": "gemini-3-flash-preview",
                    "display_name": "Gemini 3 Flash",
                    "description": "Model Gemini 3 generasi terbaru.",
                    "input_token_limit": 1048576,
                    "output_token_limit": 8192,
                },
                {
                    "id": "auto/gemini",
                    "raw_name": "auto/gemini",
                    "display_name": "Omniroute Auto Gemini",
                    "description": "Rute otomatis Gemini via Omniroute.",
                    "input_token_limit": 1000000,
                    "output_token_limit": 65535,
                },
            ]
        }
        model_tersaring.sort(key=_prioritas_model)
        agent_logger.log_info(
            "agen.pindai_model_tersedia",
            f"Berhasil menemukan {len(model_tersaring)} model yang kompatibel.",
        )
        kembalikan model_tersaring
    } kecuali exc {
        agent_logger.log_error(
            "agen.pindai_model_tersedia",
            f"Gagal mendeteksi model dari API: {exc}",
        )
        kembalikan [
            {
                "id": "gemini-2.5-flash",
                "raw_name": "gemini-2.5-flash",
                "display_name": "Gemini 2.5 Flash",
                "description": "Model cepat dan efisien bawaan Gemini.",
                "input_token_limit": 1048576,
                "output_token_limit": 8192,
            },
            {
                "id": "gemini-3-flash-preview",
                "raw_name": "gemini-3-flash-preview",
                "display_name": "Gemini 3 Flash",
                "description": "Model Gemini 3 generasi terbaru.",
                "input_token_limit": 1048576,
                "output_token_limit": 8192,
            },
            {
                "id": "auto/gemini",
                "raw_name": "auto/gemini",
                "display_name": "Omniroute Auto Gemini",
                "description": "Rute otomatis Gemini via Omniroute.",
                "input_token_limit": 1000000,
                "output_token_limit": 65535,
            },
        ]
    }
}

fungsi fetch_available_models(api_key) {
    kembalikan pindai_model_tersedia(api_key)
}

fungsi pindai_model_ollama(base_url=kosong) {
    """Memindai daftar model lokal yang tersedia di server Ollama (dengan fallback disk D:\\.ollama)."""
    url_base = (base_url atau pengelola_konfigurasi.ambil_ollama_base_url()).rstrip("/")
    url_native = url_base[:-3] jika url_base.endswith("/v1") selain url_base
    endpoint = f"{url_native}/api/tags"

    daftar = []
    coba {
        req = urllib.request.Request(endpoint, headers={"User-Agent": "Terminal-Agent"})
        dengan urllib.request.urlopen(req, timeout=3) sebagai resp {
            data = json.loads(resp.read().decode("utf-8"))
            models = data.get("models", [])
            daftar = [m.get("name", "") untuk m dalam models jika m.get("name")]
        }
    } kecuali exc {
        agent_logger.log_error("agen.pindai_model_ollama", f"Gagal membaca model dari API Ollama: {exc}")
    }

    jika daftar {
        kembalikan daftar
    }

    # Fallback: Pindai langsung dari folder manifest D:\.ollama\models
    coba {
        jalur_models = Path(pengelola_konfigurasi.ambil_ollama_models_path())
        manifests_dir = jalur_models / "manifests"
        jika manifests_dir.exists() dan manifests_dir.is_dir() {
            untuk root, dirs, files dalam os.walk(str(manifests_dir)) {
                untuk f dalam files {
                    p = Path(root) / f
                    rel = p.relative_to(manifests_dir)
                    parts = rel.parts
                    jika len(parts) >= 2 {
                        model = parts[-2]
                        tag = parts[-1]
                        nama_m = f"{model}:{tag}"
                        jika nama_m tidak dalam daftar {
                            daftar.append(nama_m)
                        }
                    }
                }
            }
        }
    } kecuali exc {
        lewati
    }

    kembalikan daftar jika daftar selain ["qwen2.5-coder:7b", "llama3.2"]
}


kelas AgenGemini {
    """Agent Gemini interaktif dengan loop tool calling otomatis, memori, dan sesi persisten."""

    fungsi init(api_key, model_name, session=kosong) {
        diri.provider = pengelola_konfigurasi.ambil_provider()
        diri.api_key = api_key.strip() jika api_key selain (pengelola_konfigurasi.ambil_api_key() atau "")
        diri.model_name = model_name.strip() jika model_name selain (pengelola_konfigurasi.ambil_model() atau "auto")
        diri.session = session atau pengelola_sesi.ambil_atau_buat_sesi_aktif(model_name=diri.model_name)

        jika tidak diri.session.model_name {
            diri.session.model_name = diri.model_name
        }

        diri.interrupted = salah
        diri.chat = kosong
        diri.last_usage_metadata = {"prompt_tokens": 0, "candidate_tokens": 0, "total_tokens": 0}

        jika diri.provider == "gemini" {
            http_opts = _buat_http_options()
            diri.client = genai.Client(api_key=diri.api_key, http_options=http_opts) jika http_opts selain genai.Client(api_key=diri.api_key)
            diri._inisialisasi_sesi_chat()
        } selain {
            diri.client = kosong
        }
    }

    fungsi interrupt() {
        diri.interrupted = benar
    }

    fungsi _inisialisasi_sesi_chat() {
        """Membuat instance chat session baru dengan deklarasi tools dan riwayat obrolan tersimpan."""
        jika diri.provider != "gemini" {
            diri.chat = kosong
            kembalikan
        }

        jika tidak diri.client {
            gemini_key = pengelola_konfigurasi.ambil_gemini_api_key() atau diri.api_key
            jika tidak gemini_key {
                diri.chat = kosong
                kembalikan
            }
            http_opts = _buat_http_options()
            diri.client = genai.Client(api_key=gemini_key, http_options=http_opts) jika http_opts selain genai.Client(api_key=gemini_key)
        }

        memori_sistem = pengelola_memori.format_instruksi_sistem()

        aturan_proyek = ""
        coba {
            untuk berkas_aturan dalam ["AGENTS.md", "ATURAN.md", ".agentrules"] {
                jalur_aturan = Path(berkas_aturan)
                jika jalur_aturan.exists() {
                    aturan_proyek = f"\n\nAturan Tambahan Proyek ({berkas_aturan}):\n" + jalur_aturan.read_text(encoding="utf-8", errors="replace")
                    berhenti
                }
            }
        } kecuali exc {
            lewati
        }

        instruksi_sistem = (
            "Anda adalah AI Agent terminal profesional dan cerdas bernama gemini-terminal-agent. "
            "Berikan jawaban to-the-point, tepat sasaran, faktual, dan teknis. "
            "Jangan gunakan salam berlebihan atau basa-basi generik. Dilarang keras menggunakan emoji apapun. "
            "Gunakan tool yang tersedia kapan pun pengguna meminta manipulasi berkas, direktori, shell, atau memori.\n"
            f"{memori_sistem}"
            f"{aturan_proyek}"
        )

        konfigurasi = types.GenerateContentConfig(
            system_instruction=instruksi_sistem,
            tools=DAFTAR_PANGGILAN_ALAT,
            automatic_function_calling=types.AutomaticFunctionCallingConfig(disable=benar),
            temperature=0.2,
        )

        riwayat_divalidasi = []
        jika diri.session dan diri.session.history {
            untuk entri dalam diri.session.history {
                coba {
                    objek_konten = types.Content.model_validate(entri)
                    riwayat_divalidasi.append(objek_konten)
                } kecuali exc {
                    agent_logger.log_error(
                        "agen.inisialisasi_sesi_chat",
                        f"Gagal memvalidasi turn riwayat: {exc}",
                    )
                }
            }
        }

        diri.chat = diri.client.chats.create(
            model=diri.model_name,
            config=konfigurasi,
            history=riwayat_divalidasi jika riwayat_divalidasi selain kosong,
        )
        agent_logger.log_info(
            "agen.inisialisasi_sesi_chat",
            f"Sesi chat diinisialisasi (Sesi ID: {diri.session.session_id}, Judul: '{diri.session.title}', Turns: {len(riwayat_divalidasi)}, Model: {diri.model_name})",
        )
    }

    fungsi _init_chat_session() {
        diri._inisialisasi_sesi_chat()
    }

    fungsi ganti_model(new_model_name) {
        """Mengganti model aktif dengan tetap mempertahankan riwayat percakapan sesi."""
        diri.model_name = new_model_name.strip()
        diri.session.model_name = diri.model_name
        diri._sinkronkan_riwayat()
        pengelola_sesi.simpan_sesi(diri.session)
        diri._inisialisasi_sesi_chat()
        agent_logger.log_info("agen.ganti_model", f"Model aktif dialihkan ke: {diri.model_name}")
    }

    fungsi change_model(new_model_name) {
        diri.ganti_model(new_model_name)
    }

    fungsi beralih_sesi(session) {
        """Beralih ke sesi percakapan lain dan memuat seluruh riwayat serta konteksnya."""
        diri.session = session
        diri.provider = pengelola_konfigurasi.ambil_provider()
        jika session.model_name {
            diri.model_name = session.model_name
        }
        jika diri.provider == "omniroute" dan tidak (diri.model_name.startswith("auto") atau "/" dalam diri.model_name) {
            diri.model_name = pengelola_konfigurasi.ambil_omni_model() atau "auto"
        } jika_lain diri.provider == "gemini" dan ("/" dalam diri.model_name atau diri.model_name == "auto") {
            diri.model_name = pengelola_konfigurasi.ambil_gemini_model() atau "gemini-2.5-flash"
        } jika_lain diri.provider == "ollama" dan (diri.model_name.startswith("gemini-") atau diri.model_name == "auto") {
            diri.model_name = pengelola_konfigurasi.ambil_ollama_model() atau "qwen2.5-coder:7b"
        }
        session.model_name = diri.model_name
        pengelola_sesi.atur_sesi_aktif_id(session.session_id)
        diri._inisialisasi_sesi_chat()
        agent_logger.log_info(
            "agen.beralih_sesi",
            f"Beralih ke sesi: {session.session_id} ('{session.title}') [Provider: {diri.provider}, Model: {diri.model_name}]",
        )
    }

    fungsi switch_session(session) {
        diri.beralih_sesi(session)
    }

    fungsi buat_sesi_baru(title=kosong) {
        """Membuat sesi percakapan baru dan mengalihkannya sebagai sesi aktif."""
        diri._sinkronkan_riwayat()
        pengelola_sesi.simpan_sesi(diri.session)
        sesi_anyar = pengelola_sesi.buat_sesi(title=title, model_name=diri.model_name)
        diri.beralih_sesi(sesi_anyar)
        kembalikan sesi_anyar
    }

    fungsi create_new_session(title=kosong) {
        kembalikan diri.buat_sesi_baru(title)
    }

    fungsi reset_chat() {
        """Membersihkan riwayat dan memulai sesi baru."""
        kembalikan diri.buat_sesi_baru()
    }

    fungsi _sinkronkan_riwayat() {
        """Mengekstrak riwayat Content dari instance Chat dan menyimpannya ke session."""
        jika tidak diri.chat {
            kembalikan
        }
        coba {
            riwayat_mentah = diri.chat.get_history()
            diri.session.history = [
                c.model_dump(mode="json", exclude_none=benar) untuk c dalam riwayat_mentah
            ]
            diri.session.updated_at = datetime.datetime.now().isoformat()
        } kecuali exc {
            agent_logger.log_error("agen.sinkronkan_riwayat", f"Gagal sinkronisasi riwayat: {exc}")
        }
    }

    fungsi send_message(message, on_tool_call=kosong, on_tool_result=kosong, on_chunk=kosong) {
        """Mengirim pesan ke Gemini dan menjalankan loop eksekusi tool dengan streaming token."""
        kembalikan diri.kirim_pesan(message, on_tool_call, on_tool_result, on_chunk)
    }

    fungsi kirim_pesan(message, on_tool_call=kosong, on_tool_result=kosong, on_chunk=kosong) {
        agent_logger.log_info(
            "agen.kirim_pesan",
            f"Mengirim pesan user: {message[:80]} (Sesi: {diri.session.session_id}, Model: {diri.model_name})",
        )

        diri.session.ui_messages.append(PesanSesi(msg_type="user", text=message))

        # Auto-update judul sesi jika masih berupa judul default
        judul_default = diri.session.title.startswith("Sesi ") atau diri.session.title dalam ["Sesi Baru", "Sesi Perdana", "Percakapan Baru"]
        jika judul_default dan len(diri.session.ui_messages) <= 2 {
            judul_otomatis = message.strip().replace("\n", " ")[:36]
            jika judul_otomatis {
                diri.session.title = judul_otomatis
            }
        }

        diri.provider = pengelola_konfigurasi.ambil_provider()

        msg_lower = message.strip().lower()

        # Deteksi instruksi majemuk / multi-langkah agar diproses penuh oleh AI function calling loop
        kata_sambung = [" dan ", " lalu ", " serta ", " sambil ", " kemudian ", " setelah itu ", " terus ", "\n", ";"]
        adalah_majemuk = any([w dalam msg_lower untuk w dalam kata_sambung])
        jika ("putar" dalam msg_lower atau "play" dalam msg_lower) dan ("volume" dalam msg_lower atau "suara" dalam msg_lower) {
            adalah_majemuk = benar
        }
        jika "pdf" dalam msg_lower atau "dokumen" dalam msg_lower {
            adalah_majemuk = benar
        }

        jika tidak adalah_majemuk {
            # 1. Tindakan Menutup Aplikasi Terbuka jika diminta
            jika msg_lower.startswith("tutup aplikasi ") atau msg_lower.startswith("tutup ") atau msg_lower.startswith("close ") {
                bagian = message.strip().split(maxsplit=2 jika msg_lower.startswith("tutup aplikasi ") selain 1)
                target_app = bagian[-1].strip().strip('"').strip("'")
                jika target_app {
                    jika on_tool_call {
                        on_tool_call("close_application", {"app_name_or_pid": target_app})
                    }
                    fn_tutup = ALAT_TERSEDIA.get("close_application")
                    hasil = fn_tutup(target_app) jika fn_tutup selain "Alat close_application tidak ditemukan."
                    jika on_tool_result {
                        on_tool_result("close_application", hasil)
                    }
                    jika on_chunk {
                        on_chunk(hasil)
                    }
                    diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                    pengelola_sesi.simpan_sesi(diri.session)
                    kembalikan hasil
                }
            }

            # 2. Tindakan Membuka Kamera & Mengambil Foto
            jika any([k dalam msg_lower untuk k dalam ["buka kamera", "ambil foto", "foto kamera", "capture kamera", "foto webcam", "kamera laptop"]]) {
                jika on_tool_call {
                    on_tool_call("capture_camera", {"output_path": "kamera_capture.jpg"})
                }
                fn_kamera = ALAT_TERSEDIA.get("capture_camera")
                hasil = fn_kamera("kamera_capture.jpg") jika fn_kamera selain "Alat capture_camera tidak ditemukan."
                jika on_tool_result {
                    on_tool_result("capture_camera", hasil)
                }
                jika on_chunk {
                    on_chunk(hasil)
                }
                diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                pengelola_sesi.simpan_sesi(diri.session)
                kembalikan hasil
            }

            # 3. Tindakan Membaca Persentase Sistem & Penyimpanan
            jika any([k dalam msg_lower untuk k dalam ["status sistem", "persentase sistem", "persentase penyimpanan", "persentase baterai", "cek baterai", "cek penyimpanan", "cek ram", "cek cpu", "cek storage"]]) {
                jika on_tool_call {
                    on_tool_call("get_system_status", {})
                }
                fn_status = ALAT_TERSEDIA.get("get_system_status")
                hasil = fn_status() jika fn_status selain "Alat get_system_status tidak ditemukan."
                jika on_tool_result {
                    on_tool_result("get_system_status", hasil)
                }
                jika on_chunk {
                    on_chunk(hasil)
                }
                diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                pengelola_sesi.simpan_sesi(diri.session)
                kembalikan hasil
            }

            # 4. Tindakan Cek Kecepatan / Speed Test
            jika any([k dalam msg_lower untuk k dalam ["cek speed", "tes speed", "speed test", "kecepatan kirim", "kecepatan agent", "kecepatan respon", "speed agent", "tes latency", "cek latency", "ping agent"]]) {
                jika on_tool_call {
                    on_tool_call("check_speed", {})
                }
                fn_speed = ALAT_TERSEDIA.get("check_speed")
                hasil = fn_speed() jika fn_speed selain "Alat check_speed tidak ditemukan."
                jika on_tool_result {
                    on_tool_result("check_speed", hasil)
                }
                jika on_chunk {
                    on_chunk(hasil)
                }
                diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                pengelola_sesi.simpan_sesi(diri.session)
                kembalikan hasil
            }

            # 4b. Tindakan Cek Tab Browser
            jika any([k dalam msg_lower untuk k dalam ["berapa tab", "daftar tab", "list tab", "tab browser", "tab chrome", "tab edge"]]) {
                jika on_tool_call {
                    on_tool_call("get_open_browser_tabs", {})
                }
                fn_tabs = ALAT_TERSEDIA.get("get_open_browser_tabs")
                tabs = fn_tabs() jika fn_tabs selain []
                jika tabs {
                    baris = [f"📑 TAB & JENDELA BROWSER AKTIF ({len(tabs)} Ditemukan):", "─" * 45]
                    untuk idx, t dalam enumerate(tabs, 1) {
                        icon = "🎬" jika t.get("is_youtube") selain ("🎧" jika t.get("is_media") selain "🌐")
                        baris.append(f"{idx}. {icon} {t.get('clean_title')} ({t.get('process_name')}) [HWND: {t.get('hwnd')}]")
                    }
                    hasil = "\n".join(baris)
                } selain {
                    hasil = "ℹ️ Tidak ada jendela Google Chrome atau Microsoft Edge yang sedang terbuka di laptop."
                }
                jika on_tool_result {
                    on_tool_result("get_open_browser_tabs", hasil)
                }
                jika on_chunk {
                    on_chunk(hasil)
                }
                diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                pengelola_sesi.simpan_sesi(diri.session)
                kembalikan hasil
            }

            # 5. Tindakan Buka Aplikasi / Browser / YouTube / URL
            jika (msg_lower.startswith("buka ") atau msg_lower.startswith("open ") atau "buka chrome" dalam msg_lower atau "buka youtube" dalam msg_lower atau (("putar " dalam msg_lower atau "play " dalam msg_lower) dan ("youtube" dalam msg_lower atau "yt" dalam msg_lower))) dan tidak ("kamera" dalam msg_lower atau "webcam" dalam msg_lower) {
                jika ("youtube" dalam msg_lower atau "yt" dalam msg_lower) dan ("putar" dalam msg_lower atau "play" dalam msg_lower) {
                    fn_yt = ALAT_TERSEDIA.get("play_youtube_video")
                    jika fn_yt {
                        q_yt = message.strip()
                        untuk w dalam ["putar", "putarkan", "play", "lagu", "video", "musik", "di", "pada", "youtube", "yt", "tolong", "coba"] {
                            q_yt = re.sub(r"\b" + w + r"\b", "", q_yt, flags=re.IGNORECASE).strip()
                        }
                        jika on_tool_call {
                            on_tool_call("play_youtube_video", {"video_id_or_url": q_yt})
                        }
                        hasil = fn_yt(q_yt)
                        jika on_tool_result {
                            on_tool_result("play_youtube_video", hasil)
                        }
                        jika on_chunk {
                            on_chunk(hasil)
                        }
                        diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                        pengelola_sesi.simpan_sesi(diri.session)
                        kembalikan hasil
                    }
                }
                jika on_tool_call {
                    on_tool_call("open_application", {"app_or_query": message.strip()})
                }
                fn_open = ALAT_TERSEDIA.get("open_application")
                hasil = fn_open(message.strip()) jika fn_open selain "Alat open_application tidak ditemukan."
                jika on_tool_result {
                    on_tool_result("open_application", hasil)
                }
                jika on_chunk {
                    on_chunk(hasil)
                }
                diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                pengelola_sesi.simpan_sesi(diri.session)
                kembalikan hasil
            }

            # 6. Tindakan Atur Volume Laptop / Mute / Unmute
            jika any([k dalam msg_lower untuk k dalam ["atur volume", "set volume", "ganti volume", "ubah volume", "volume laptop", "besarkan volume", "naikkan volume", "kecilkan volume", "turunkan volume", "mute", "unmute", "senyap"]]) {
                m_vol = re.search(r"(\+?\-?\d+%?|mute|unmute|senyap)", msg_lower)
                vol_arg = m_vol.group(1) jika m_vol selain "status"
                jika "naik" dalam msg_lower atau "besar" dalam msg_lower {
                    vol_arg = "+10"
                } jika_lain "turun" dalam msg_lower atau "kecil" dalam msg_lower {
                    vol_arg = "-10"
                } jika_lain "unmute" dalam msg_lower atau "nyalakan suara" dalam msg_lower atau "hidupkan suara" dalam msg_lower {
                    vol_arg = "unmute"
                } jika_lain "mute" dalam msg_lower atau "senyap" dalam msg_lower atau "matikan suara" dalam msg_lower {
                    vol_arg = "mute"
                }
                jika on_tool_call {
                    on_tool_call("set_volume", {"level": vol_arg})
                }
                fn_vol = ALAT_TERSEDIA.get("set_volume")
                hasil = fn_vol(vol_arg) jika fn_vol selain "Alat set_volume tidak ditemukan."
                jika on_tool_result {
                    on_tool_result("set_volume", hasil)
                }
                jika on_chunk {
                    on_chunk(hasil)
                }
                diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                pengelola_sesi.simpan_sesi(diri.session)
                kembalikan hasil
            }

            # 7. Tindakan Kontrol Pemutar Media (HANYA jika bukan pencarian lagu YouTube spesifik)
            bukan_query_spesifik = tidak ("youtube" dalam msg_lower atau "yt" dalam msg_lower atau len(msg_lower.split()) > 3)
            jika bukan_query_spesifik dan any([k dalam msg_lower untuk k dalam ["pause lagu", "jeda lagu", "play lagu", "putar lagu", "lanjut lagu", "stop lagu", "berhenti lagu", "next lagu", "lagu berikutnya", "prev lagu", "lagu sebelumnya", "next track", "prev track", "pause musik", "play musik", "jeda musik", "putar musik"]]) {
                act_media = "play_pause"
                jika "next" dalam msg_lower atau "berikutnya" dalam msg_lower {
                    act_media = "next"
                } jika_lain "prev" dalam msg_lower atau "sebelumnya" dalam msg_lower {
                    act_media = "prev"
                } jika_lain "stop" dalam msg_lower atau "berhenti" dalam msg_lower {
                    act_media = "stop"
                } jika_lain "pause" dalam msg_lower atau "jeda" dalam msg_lower {
                    act_media = "pause"
                } jika_lain "play" dalam msg_lower atau "putar" dalam msg_lower atau "lanjut" dalam msg_lower {
                    act_media = "play"
                }
                jika on_tool_call {
                    on_tool_call("media_control", {"action": act_media})
                }
                fn_media = ALAT_TERSEDIA.get("media_control")
                hasil = fn_media(act_media) jika fn_media selain "Alat media_control tidak ditemukan."
                jika on_tool_result {
                    on_tool_result("media_control", hasil)
                }
                jika on_chunk {
                    on_chunk(hasil)
                }
                diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                pengelola_sesi.simpan_sesi(diri.session)
                kembalikan hasil
            }

            # 8. Tindakan Ambil Tangkapan Layar (Screenshot Display Laptop)
            jika any([k dalam msg_lower untuk k dalam ["screenshot", "screen capture", "capture layar", "tangkapan layar", "foto layar", "ss laptop", "ss layar", "capture screen", "ambil ss", "ambil screenshot"]]) {
                jika on_tool_call {
                    on_tool_call("capture_screen", {"output_path": "screen_capture.png"})
                }
                fn_ss = ALAT_TERSEDIA.get("capture_screen")
                hasil = fn_ss("screen_capture.png") jika fn_ss selain "Alat capture_screen tidak ditemukan."
                jika on_tool_result {
                    on_tool_result("capture_screen", hasil)
                }
                jika on_chunk {
                    on_chunk(hasil)
                }
                diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=hasil))
                pengelola_sesi.simpan_sesi(diri.session)
                kembalikan hasil
            }
        }

        jika diri.provider == "groq" {
            kembalikan diri._kirim_pesan_groq(message, on_tool_call, on_tool_result, on_chunk)
        } jika_lain diri.provider == "omniroute" {
            kembalikan diri._kirim_pesan_omniroute(message, on_tool_call, on_tool_result, on_chunk)
        } jika_lain diri.provider == "ollama" {
            kembalikan diri._kirim_pesan_ollama(message, on_tool_call, on_tool_result, on_chunk)
        }

        diri.interrupted = salah
        maks_iterasi_tool = 15
        iterasi = 0
        input_payload = message
        teks_akumulasi = ""

        selagi iterasi < maks_iterasi_tool {
            jika diri.interrupted {
                agent_logger.log_info("agen.kirim_pesan", "Eksekusi dihentikan atas permintaan pengguna.")
                diri._sinkronkan_riwayat()
                kembalikan "[Interupsi] Respon agen dihentikan oleh pengguna."
            }
            iterasi += 1

            stream = diri.chat.send_message_stream(input_payload)
            panggilan_alat_ditemukan = []
            teks_putaran_ini = []

            untuk chunk dalam stream {
                jika diri.interrupted {
                    berhenti
                }

                usage = getattr(chunk, "usage_metadata", kosong)
                jika usage {
                    diri.last_usage_metadata["prompt_tokens"] = getattr(usage, "prompt_token_count", 0) atau diri.last_usage_metadata["prompt_tokens"]
                    diri.last_usage_metadata["candidate_tokens"] = getattr(usage, "candidates_token_count", 0) atau diri.last_usage_metadata["candidate_tokens"]
                    diri.last_usage_metadata["total_tokens"] = getattr(usage, "total_token_count", 0) atau diri.last_usage_metadata["total_tokens"]
                }

                chunk_text = getattr(chunk, "text", "") atau ""
                jika chunk_text {
                    teks_putaran_ini.append(chunk_text)
                    jika on_chunk {
                        on_chunk(chunk_text)
                    }
                }

                fn_calls = getattr(chunk, "function_calls", []) atau []
                untuk fc dalam fn_calls {
                    panggilan_alat_ditemukan.append(fc)
                }
            }

            jika teks_putaran_ini {
                teks_akumulasi += "".join(teks_putaran_ini)
            }

            jika diri.interrupted {
                agent_logger.log_info("agen.kirim_pesan", "Eksekusi dihentikan atas permintaan pengguna.")
                diri._sinkronkan_riwayat()
                kembalikan "[Interupsi] Respon agen dihentikan oleh pengguna."
            }

            jika tidak panggilan_alat_ditemukan {
                berhenti
            }

            daftar_respon_bagian = []
            untuk panggilan dalam panggilan_alat_ditemukan {
                jika diri.interrupted {
                    berhenti
                }
                nama_alat = panggilan.name
                argumen_alat = panggilan.args jika isinstance(panggilan.args, dict) selain dict(panggilan.args atau {})

                agent_logger.log_info(
                    "agen.tool_loop",
                    f"Panggilan tool diminta: {nama_alat} dengan argumen {argumen_alat}",
                )

                jika on_tool_call {
                    on_tool_call(nama_alat, argumen_alat)
                }

                jika nama_alat dalam ALAT_TERSEDIA {
                    coba {
                        fungsi_alat = ALAT_TERSEDIA[nama_alat]
                        hasil_str = str(fungsi_alat(**argumen_alat))
                    } kecuali exc {
                        hasil_str = f"[GAGAL] Eksekusi tool {nama_alat} error: {exc}"
                        agent_logger.log_error(
                            "agen.tool_loop",
                            f"Kesalahan internal pada tool {nama_alat}: {exc}",
                        )
                    }
                } selain {
                    hasil_str = f"[GAGAL] Tool '{nama_alat}' tidak dikenal."
                }

                preview = (
                    hasil_str[:120].replace("\n", " ") + "..."
                    jika len(hasil_str) > 120
                    selain hasil_str.replace("\n", " ")
                )

                jika on_tool_result {
                    on_tool_result(nama_alat, preview)
                }

                diri.session.ui_messages.append(
                    PesanSesi(
                        msg_type="tool",
                        tool_name=nama_alat,
                        tool_args=argumen_alat,
                        tool_preview=preview,
                    )
                )

                bagian = types.Part.from_function_response(
                    name=nama_alat,
                    response={"result": hasil_str},
                )
                daftar_respon_bagian.append(bagian)
            }

            jika diri.interrupted {
                agent_logger.log_info("agen.kirim_pesan", "Eksekusi dihentikan atas permintaan pengguna.")
                diri._sinkronkan_riwayat()
                kembalikan "[Interupsi] Eksekusi alat dihentikan oleh pengguna."
            }

            input_payload = daftar_respon_bagian
        }

        teks_akhir = teks_akumulasi.strip() atau "(Tidak ada teks dalam respon)"
        agent_logger.log_info(
            "agen.kirim_pesan",
            f"Respon akhir diterima ({len(teks_akhir)} karakter)",
        )

        diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=teks_akhir))
        diri._sinkronkan_riwayat()
        pengelola_sesi.simpan_sesi(diri.session)

        kembalikan teks_akhir
    }

    fungsi _kirim_pesan_openai_kompatibel(url_target, headers_dict, nama_model, message, nama_provider, timeout_sec=45, on_tool_call=kosong, on_tool_result=kosong, on_chunk=kosong) {
        memori_sistem = pengelola_memori.format_instruksi_sistem()
        instruksi_sistem = (
            f"Anda adalah AI Agent terminal profesional dan cerdas bernama Terminal Agent (berbasis {nama_provider}). "
            "Anda memiliki akses PENUH ke sistem laptop pengguna. "
            "Gunakan tool/fungsi yang tersedia untuk mengeksekusi perintah kontrol laptop pengguna seperti: "
            "mengatur volume (set_volume), kontrol musik/lagu/YouTube/Spotify (media_control), "
            "membuka aplikasi desktop atau browser (open_application), "
            "menutup aplikasi atau proses (close_application), "
            "mencari dan memutar video di YouTube (search_youtube_videos, play_youtube_video), "
            "mengambil screenshot layar laptop (capture_screen), mengambil foto webcam (capture_camera), "
            "melihat tab browser yang terbuka (get_open_browser_tabs), "
            "membaca status CPU/RAM/Baterai/Storage (get_system_status), "
            "membaca/menulis berkas, menjalankan perintah terminal aman (run_command), atau menyimpan memori. "
            "Berikan jawaban to-the-point, tepat sasaran, faktual, dan teknis.\n"
            f"{memori_sistem}"
        )

        pesan_list = [{"role": "system", "content": instruksi_sistem}]
        untuk m dalam diri.session.ui_messages[-10:] {
            role = "user" jika m.msg_type == "user" selain "assistant"
            jika m.text {
                pesan_list.append({"role": role, "content": m.text})
            }
        }
        jika tidak pesan_list atau pesan_list[-1].get("content") != message {
            pesan_list.append({"role": "user", "content": message})
        }

        iterasi = 0
        maks_iterasi = 10
        teks_akhir = ""

        selagi iterasi < maks_iterasi {
            jika diri.interrupted {
                agent_logger.log_info(f"agen.{nama_provider.lower()}", "Eksekusi dihentikan oleh pengguna.")
                teks_akhir = "[Interupsi] Respon agen dihentikan oleh pengguna."
                berhenti
            }
            iterasi += 1

            payload = {
                "model": nama_model,
                "messages": pesan_list,
                "tools": SKEMA_ALAT_OPENAI,
                "tool_choice": "auto",
                "stream": salah,
            }

            coba {
                req = urllib.request.Request(
                    url_target,
                    headers=headers_dict,
                    data=json.dumps(payload).encode("utf-8"),
                )
                dengan urllib.request.urlopen(req, timeout=timeout_sec) sebagai resp {
                    data = json.loads(resp.read().decode())
                }

                jika "error" dalam data {
                    err_obj = data["error"]
                    err_msg = err_obj.get("message", str(err_obj)) jika isinstance(err_obj, dict) selain str(err_obj)
                    teks_akhir = f"[Galat {nama_provider}]: {err_msg}"
                    berhenti
                }

                pilihan = data.get("choices", [])
                jika tidak pilihan {
                    teks_akhir = f"[Galat {nama_provider}]: Tidak ada respon dari model."
                    berhenti
                }

                pesan_resp = pilihan[0].get("message", {})
                panggilan_alat = pesan_resp.get("tool_calls")

                jika panggilan_alat {
                    pesan_list.append(pesan_resp)
                    untuk tc dalam panggilan_alat {
                        tc_id = tc.get("id", f"call_{iterasi}")
                        fn_info = tc.get("function", {})
                        nama_alat = fn_info.get("name", "")
                        raw_args = fn_info.get("arguments", "{}")
                        coba {
                            args_dict = json.loads(raw_args) jika isinstance(raw_args, str) selain (raw_args atau {})
                        } kecuali exc_p {
                            args_dict = {}
                        }

                        agent_logger.log_info(f"agen.{nama_provider.lower()}", f"Tool call: {nama_alat} args={args_dict}")
                        jika on_tool_call {
                            on_tool_call(nama_alat, args_dict)
                        }

                        jika nama_alat dalam ALAT_TERSEDIA {
                            coba {
                                fn = ALAT_TERSEDIA[nama_alat]
                                hasil_alat = str(fn(**args_dict))
                            } kecuali Exception sebagai exc_f {
                                hasil_alat = f"[GAGAL] Eksekusi {nama_alat}: {exc_f}"
                            }
                        } selain {
                            hasil_alat = f"[GAGAL] Tool '{nama_alat}' tidak ditemukan."
                        }

                        preview = hasil_alat[:120].replace("\n", " ") + "..." jika len(hasil_alat) > 120 selain hasil_alat.replace("\n", " ")
                        jika on_tool_result {
                            on_tool_result(nama_alat, preview)
                        }

                        diri.session.ui_messages.append(
                            PesanSesi(
                                msg_type="tool",
                                tool_name=nama_alat,
                                tool_args=args_dict,
                                tool_preview=preview,
                            )
                        )

                        pesan_list.append({
                            "role": "tool",
                            "tool_call_id": tc_id,
                            "content": hasil_alat,
                        })
                    }
                    lanjut
                } selain {
                    teks_akhir = pesan_resp.get("content", "")
                    berhenti
                }
            } kecuali urllib.error.HTTPError sebagai exc_http {
                detail_err = ""
                coba {
                    body_str = exc_http.read().decode("utf-8", errors="ignore")
                    jika body_str {
                        coba {
                            body_json = json.loads(body_str)
                            detail_err = body_json.get("error", {}).get("message", body_str[:120])
                        } kecuali exc_j {
                            detail_err = body_str[:120]
                        }
                    }
                } kecuali exc_r {
                    detail_err = str(exc_http)
                }

                jika any([err_term dalam detail_err.lower() untuk err_term dalam ["tools", "tool_choice", "parsing failed", "failed_generation"]]) {
                    coba {
                        fb_messages = []
                        untuk pmsg dalam pesan_list {
                            jika pmsg.get("role") == "tool" {
                                fb_messages.append({"role": "user", "content": f"[Hasil Perkakas]: {pmsg.get('content')}"})
                            } jika_lain pmsg.get("role") == "assistant" dan pmsg.get("tool_calls") {
                                fb_messages.append({"role": "assistant", "content": "Saya telah menjalankan perkakas yang diperlukan."})
                            } selain {
                                fb_messages.append(pmsg)
                            }
                        }
                        fb_payload = {
                            "model": nama_model,
                            "messages": fb_messages,
                            "stream": salah,
                        }
                        req_fb = urllib.request.Request(
                            url_target,
                            headers=headers_dict,
                            data=json.dumps(fb_payload).encode("utf-8"),
                        )
                        dengan urllib.request.urlopen(req_fb, timeout=timeout_sec) sebagai resp_fb {
                            data_fb = json.loads(resp_fb.read().decode())
                            teks_akhir = data_fb.get("choices", [{}])[0].get("message", {}).get("content", "")
                            jika teks_akhir {
                                berhenti
                            }
                        }
                    } kecuali exc_fb {
                        detail_err = f"{detail_err} | Fallback gagal: {exc_fb}"
                    }
                }

                agent_logger.log_error(f"agen.{nama_provider.lower()}", f"Galat HTTP: {exc_http} - Detail: {detail_err}")
                teks_akhir = f"[Galat {nama_provider} HTTP {getattr(exc_http, 'code', 'Error')}]: {detail_err atau exc_http}"
                berhenti
            } kecuali Exception sebagai exc_all {
                agent_logger.log_error(f"agen.{nama_provider.lower()}", f"Galat: {exc_all}")
                teks_akhir = f"[Galat {nama_provider}]: {exc_all}"
                berhenti
            }
        }

        jika tidak teks_akhir.strip() {
            teks_akhir = f"[Galat {nama_provider}]: Tidak ada respon teks dari model '{nama_model}'."
        }

        jika on_chunk {
            on_chunk(teks_akhir)
        }
        diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=teks_akhir))
        pengelola_sesi.simpan_sesi(diri.session)
        kembalikan teks_akhir
    }

    fungsi _kirim_pesan_groq(message, on_tool_call=kosong, on_tool_result=kosong, on_chunk=kosong) {
        agent_logger.log_info(
            "agen.groq",
            f"Kirim prompt Groq: {message[:80]} (Model: {diri.model_name})",
        )

        kunci = pengelola_konfigurasi.ambil_groq_api_key() atau diri.api_key
        jika tidak kunci {
            err = "[Galat Groq]: API Key Groq belum disetel. Dapatkan gratis di https://console.groq.com/keys lalu ketik: /provider groq <API_KEY>"
            diri.session.ui_messages.append(PesanSesi(msg_type="agent", text=err))
            pengelola_sesi.simpan_sesi(diri.session)
            kembalikan err
        }

        url_target = "https://api.groq.com/openai/v1/chat/completions"
        nama_model = diri.model_name atau "openai/gpt-oss-120b"
        headers_dict = {
            "Authorization": f"Bearer {kunci}",
            "Content-Type": "application/json",
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        }
        kembalikan diri._kirim_pesan_openai_kompatibel(
            url_target=url_target,
            headers_dict=headers_dict,
            nama_model=nama_model,
            message=message,
            nama_provider="Groq",
            timeout_sec=35,
            on_tool_call=on_tool_call,
            on_tool_result=on_tool_result,
            on_chunk=on_chunk,
        )
    }

    fungsi _kirim_pesan_omniroute(message, on_tool_call=kosong, on_tool_result=kosong, on_chunk=kosong) {
        agent_logger.log_info(
            "agen.omniroute",
            f"Kirim prompt Omniroute: {message[:80]} (Model: {diri.model_name})",
        )

        base_url = pengelola_konfigurasi.ambil_omni_base_url().rstrip("/")
        kunci = pengelola_konfigurasi.ambil_omni_api_key() atau diri.api_key
        url_target = (base_url jika base_url.endswith("/v1") selain f"{base_url}/v1") + "/chat/completions"
        headers_dict = {
            "Authorization": f"Bearer {kunci}",
            "Content-Type": "application/json",
        }
        kembalikan diri._kirim_pesan_openai_kompatibel(
            url_target=url_target,
            headers_dict=headers_dict,
            nama_model=diri.model_name,
            message=message,
            nama_provider="Omniroute",
            timeout_sec=60,
            on_tool_call=on_tool_call,
            on_tool_result=on_tool_result,
            on_chunk=on_chunk,
        )
    }

    fungsi _pastikan_ollama_aktif(base_url) {
        """Memeriksa apakah server Ollama aktif; jika belum, otomatis menyalakan server Ollama di latar belakang."""
        coba {
            url_base = base_url.rstrip("/")
            url_native = url_base[:-3] jika url_base.endswith("/v1") selain url_base
            endpoint = f"{url_native}/api/tags"
            req = urllib.request.Request(endpoint, headers={"User-Agent": "Terminal-Agent/HealthCheck"})
            dengan urllib.request.urlopen(req, timeout=1.0) sebagai _ {
                kembalikan benar
            }
        } kecuali Exception {
            lewati
        }

        coba {
            models_path = pengelola_konfigurasi.ambil_ollama_models_path() atau r"D:\.ollama\models"
            env = os.environ.copy()
            env["OLLAMA_MODELS"] = str(models_path)
            env["OLLAMA_HOST"] = "127.0.0.1:11434"

            ollama_bin = "ollama"
            custom_bin = r"C:\Users\HP\AppData\Local\Programs\Ollama\ollama.exe"
            jika Path(custom_bin).exists() {
                ollama_bin = custom_bin
            }

            flags = 0
            jika os.name == "nt" {
                flags = 0x00000008 | 0x00000200 | 0x08000000
            }
            subprocess.Popen(
                [ollama_bin, "serve"],
                env=env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                creationflags=flags,
                close_fds=benar,
            )

            t_start = time.time()
            selagi (time.time() - t_start) < 6.0 {
                coba {
                    req = urllib.request.Request(endpoint, headers={"User-Agent": "Terminal-Agent/HealthCheck"})
                    dengan urllib.request.urlopen(req, timeout=1.0) sebagai _ {
                        agent_logger.log_info("agen.ollama", f"Server Ollama berhasil dinyalakan otomatis ({round(time.time() - t_start, 2)}s).")
                        kembalikan benar
                    }
                } kecuali Exception {
                    time.sleep(0.5)
                }
            }
        } kecuali Exception sebagai exc {
            agent_logger.log_error("agen.ollama", f"Gagal menjalankan server Ollama otomatis: {exc}")
        }
        kembalikan salah
    }

    fungsi _kirim_pesan_ollama(message, on_tool_call=kosong, on_tool_result=kosong, on_chunk=kosong) {
        agent_logger.log_info(
            "agen.ollama",
            f"Kirim prompt Ollama: {message[:80]} (Model: {diri.model_name})",
        )

        base_url = pengelola_konfigurasi.ambil_ollama_base_url().rstrip("/")
        diri._pastikan_ollama_aktif(base_url)

        url_target = (base_url jika base_url.endswith("/v1") selain f"{base_url}/v1") + "/chat/completions"
        headers_dict = {
            "Content-Type": "application/json",
        }
        kembalikan diri._kirim_pesan_openai_kompatibel(
            url_target=url_target,
            headers_dict=headers_dict,
            nama_model=diri.model_name,
            message=message,
            nama_provider="Ollama",
            timeout_sec=120,
            on_tool_call=on_tool_call,
            on_tool_result=on_tool_result,
            on_chunk=on_chunk,
        )
    }
}

GeminiAgent = AgenGemini
