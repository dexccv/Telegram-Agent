# ======================================================================
# TeleAgent - Template Konfigurasi Lingkungan (.env.example)
# Autonomous AI Terminal Agent & Mobile Telegram Gateway
#
# Salin berkas ini menjadi '.env' atau jalankan 'setup.bat' untuk
# panduan konfigurasi otomatis:
#   copy .env.example .env
# ======================================================================

# 1. Gateway Telegram Bot (Wajib untuk Remote Control)
# Dapatkan token bot dari @BotFather di Telegram (/newbot)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# User ID Telegram pemilik akun (hanya ID ini yang diizinkan mengontrol laptop)
# Dapatkan otomatis via 'setup.bat' atau cek ke bot @userinfobot
TELEGRAM_ALLOWED_USER_ID=5467304452

# 2. Kunci AI Model Provider (Pilih minimal satu)
# Google Gemini API Key (Rekomendasi Utama, gratis di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyExampleKeyHere_1234567890

# Groq API Key (Opsional, untuk kecepatan kilat Llama-3 / Mixtral: https://console.groq.com/keys)
GROQ_API_KEY=gsk_exampleKeyHere_1234567890

# Ollama Local AI Host (Opsional, jika menjalankan model lokal)
OLLAMA_HOST=http://127.0.0.1:11434

# 3. Model Default Saat Pertama Kali Dijalankan
DEFAULT_AI_PROVIDER=gemini
DEFAULT_MODEL_NAME=gemini-2.5-flash

# 4. Pengaturan Remote Desktop & Antigravity IDE
ANTIGRAVITY_AUTO_MAXIMIZE=true
SECURITY_SANDBOX_STRICT=true

