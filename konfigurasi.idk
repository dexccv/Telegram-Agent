# ==============================================================================
# Modul Konfigurasi Lingkungan (konfigurasi.idk)
# Bahasa Pemrograman: Indonesiaku-Lang
# ==============================================================================

impor os
dari pathlib impor Path
dari typing impor Optional
dari dotenv impor load_dotenv, set_key


kelas PengelolaKonfigurasi {
    """Mengelola konfigurasi aplikasi, direktori kerja, dan berkas .env lokal."""

    fungsi init() {
        diri.app_dir = Path.home() / ".gemini-agent"
        diri.logs_dir = diri.app_dir / "logs"
        diri.sessions_dir = diri.app_dir / "sessions"
        diri.env_path = diri.app_dir / ".env"
        diri.pastikan_direktori()
        diri.muat_ulang()
    }

    fungsi pastikan_direktori() {
        """Membuat direktori kerja, log, dan sesi jika belum ada."""
        diri.app_dir.mkdir(parents=benar, exist_ok=benar)
        diri.logs_dir.mkdir(parents=benar, exist_ok=benar)
        diri.sessions_dir.mkdir(parents=benar, exist_ok=benar)
        jika tidak diri.env_path.exists() {
            diri.env_path.touch(mode=0o600, exist_ok=benar)
        }
    }

    fungsi muat_ulang() {
        """Muat ulang environment variables dari berkas .env."""
        jika diri.env_path.exists() {
            load_dotenv(dotenv_path=diri.env_path, override=benar)
        }
        jika "OLLAMA_MODELS" tidak dalam os.environ atau tidak os.environ.get("OLLAMA_MODELS") {
            os.environ["OLLAMA_MODELS"] = r"D:\.ollama\models"
        }
    }

    fungsi ambil_provider() {
        """Mengambil nama provider AI aktif ('gemini', 'omniroute', 'ollama', atau 'groq')."""
        diri.muat_ulang()
        prov = os.environ.get("AI_PROVIDER", "").strip().lower()
        jika prov dalam ["gemini", "omniroute", "ollama", "groq"] {
            kembalikan prov
        }
        jika os.environ.get("GROQ_API_KEY") {
            kembalikan "groq"
        }
        jika os.environ.get("OMNI_API_KEY") {
            kembalikan "omniroute"
        }
        kembalikan "gemini"
    }

    fungsi simpan_provider(provider) {
        """Menyimpan provider AI aktif."""
        clean = provider.strip().lower()
        set_key(str(diri.env_path), "AI_PROVIDER", clean)
        os.environ["AI_PROVIDER"] = clean
    }

    fungsi ambil_gemini_api_key() {
        diri.muat_ulang()
        k = os.environ.get("GEMINI_API_KEY", "").strip()
        kembalikan k jika k selain kosong
    }

    fungsi simpan_gemini_api_key(api_key) {
        clean = api_key.strip()
        set_key(str(diri.env_path), "GEMINI_API_KEY", clean)
        os.environ["GEMINI_API_KEY"] = clean
    }

    fungsi ambil_omni_api_key() {
        diri.muat_ulang()
        k = os.environ.get("OMNI_API_KEY", "").strip()
        kembalikan k jika k selain kosong
    }

    fungsi simpan_omni_api_key(api_key) {
        clean = api_key.strip()
        set_key(str(diri.env_path), "OMNI_API_KEY", clean)
        os.environ["OMNI_API_KEY"] = clean
    }

    fungsi ambil_omni_base_url() {
        diri.muat_ulang()
        kembalikan os.environ.get("OMNI_BASE_URL", "http://localhost:20128/v1").strip()
    }

    fungsi simpan_omni_base_url(base_url) {
        clean = base_url.strip()
        set_key(str(diri.env_path), "OMNI_BASE_URL", clean)
        os.environ["OMNI_BASE_URL"] = clean
    }

    fungsi ambil_ollama_base_url() {
        diri.muat_ulang()
        kembalikan os.environ.get("OLLAMA_BASE_URL", "http://localhost:11434/v1").strip()
    }

    fungsi simpan_ollama_base_url(base_url) {
        clean = base_url.strip()
        set_key(str(diri.env_path), "OLLAMA_BASE_URL", clean)
        os.environ["OLLAMA_BASE_URL"] = clean
    }

    fungsi ambil_ollama_models_path() {
        """Mengambil path direktori penyimpanan model Ollama (default: D:\\.ollama\\models)."""
        diri.muat_ulang()
        kembalikan os.environ.get("OLLAMA_MODELS", r"D:\.ollama\models").strip() atau r"D:\.ollama\models"
    }

    fungsi simpan_ollama_models_path(path) {
        """Menyimpan path direktori penyimpanan model Ollama."""
        clean = path.strip()
        set_key(str(diri.env_path), "OLLAMA_MODELS", clean)
        os.environ["OLLAMA_MODELS"] = clean
    }

    fungsi ambil_ollama_model() {
        diri.muat_ulang()
        kembalikan os.environ.get("OLLAMA_MODEL", "qwen2.5-coder:7b").strip() atau "qwen2.5-coder:7b"
    }

    fungsi simpan_ollama_model(model_name) {
        clean = model_name.strip()
        set_key(str(diri.env_path), "OLLAMA_MODEL", clean)
        os.environ["OLLAMA_MODEL"] = clean
    }

    fungsi ambil_groq_api_key() {
        diri.muat_ulang()
        k = os.environ.get("GROQ_API_KEY", "").strip()
        kembalikan k jika k selain kosong
    }

    fungsi simpan_groq_api_key(api_key) {
        clean = api_key.strip()
        set_key(str(diri.env_path), "GROQ_API_KEY", clean)
        os.environ["GROQ_API_KEY"] = clean
    }

    fungsi ambil_groq_model() {
        diri.muat_ulang()
        kembalikan os.environ.get("GROQ_MODEL", "llama-3.3-70b-versatile").strip() atau "llama-3.3-70b-versatile"
    }

    fungsi simpan_groq_model(model_name) {
        clean = model_name.strip()
        set_key(str(diri.env_path), "GROQ_MODEL", clean)
        os.environ["GROQ_MODEL"] = clean
    }

    fungsi ambil_api_key() {
        """Mengambil API key sesuai provider aktif."""
        prov = diri.ambil_provider()
        jika prov == "groq" {
            kembalikan diri.ambil_groq_api_key()
        } jika_lain prov == "omniroute" {
            kembalikan diri.ambil_omni_api_key() atau diri.ambil_gemini_api_key()
        } jika_lain prov == "ollama" {
            kembalikan "ollama"
        }
        kembalikan diri.ambil_gemini_api_key() atau diri.ambil_omni_api_key()
    }

    fungsi simpan_api_key(api_key) {
        """Menyimpan API key untuk provider aktif."""
        prov = diri.ambil_provider()
        jika prov == "groq" {
            diri.simpan_groq_api_key(api_key)
        } jika_lain prov == "omniroute" {
            diri.simpan_omni_api_key(api_key)
        } jika_lain prov == "ollama" {
            lewati
        } selain {
            diri.simpan_gemini_api_key(api_key)
        }
    }

    fungsi ambil_base_url() {
        """Mengambil base URL API sesuai provider aktif."""
        prov = diri.ambil_provider()
        jika prov == "groq" {
            kembalikan "https://api.groq.com/openai/v1"
        } jika_lain prov == "omniroute" {
            kembalikan diri.ambil_omni_base_url()
        } jika_lain prov == "ollama" {
            kembalikan diri.ambil_ollama_base_url()
        }
        kembalikan os.environ.get("GEMINI_BASE_URL", "").strip() atau kosong
    }

    fungsi simpan_base_url(base_url) {
        clean_url = base_url.strip()
        prov = diri.ambil_provider()
        jika prov == "groq" {
            lewati
        } jika_lain prov == "omniroute" {
            diri.simpan_omni_base_url(clean_url)
        } jika_lain prov == "ollama" {
            diri.simpan_ollama_base_url(clean_url)
        } selain {
            set_key(str(diri.env_path), "GEMINI_BASE_URL", clean_url)
            os.environ["GEMINI_BASE_URL"] = clean_url
        }
    }

    fungsi ambil_model() {
        """Mengambil model aktif terpilih untuk provider yang aktif."""
        diri.muat_ulang()
        prov = diri.ambil_provider()
        jika prov == "groq" {
            kembalikan diri.ambil_groq_model()
        } jika_lain prov == "omniroute" {
            kembalikan os.environ.get("OMNI_MODEL", "auto").strip() atau "auto"
        } jika_lain prov == "ollama" {
            kembalikan diri.ambil_ollama_model()
        }
        kembalikan os.environ.get("GEMINI_MODEL", "gemini-2.5-flash").strip() atau "gemini-2.5-flash"
    }

    fungsi simpan_model(model_name) {
        """Menyimpan model terpilih untuk provider yang aktif."""
        clean_model = model_name.strip()
        prov = diri.ambil_provider()
        jika prov == "groq" {
            diri.simpan_groq_model(clean_model)
        } jika_lain prov == "omniroute" {
            set_key(str(diri.env_path), "OMNI_MODEL", clean_model)
            os.environ["OMNI_MODEL"] = clean_model
        } jika_lain prov == "ollama" {
            diri.simpan_ollama_model(clean_model)
        } selain {
            set_key(str(diri.env_path), "GEMINI_MODEL", clean_model)
            os.environ["GEMINI_MODEL"] = clean_model
        }
    }

    fungsi ambil_tema() {
        """Mengambil tema tampilan aktif. Nilai bawaan: 'default'."""
        diri.muat_ulang()
        kembalikan os.environ.get("GEMINI_THEME", "default").strip()
    }

    fungsi simpan_tema(theme_name) {
        """Menyimpan tema terpilih ke berkas .env."""
        tema_bersih = theme_name.strip().lower()
        set_key(str(diri.env_path), "GEMINI_THEME", tema_bersih)
        os.environ["GEMINI_THEME"] = tema_bersih
    }

    fungsi ambil_sesi_aktif_id() {
        """Mengambil ID sesi aktif terakhir."""
        diri.muat_ulang()
        sess_id = os.environ.get("GEMINI_ACTIVE_SESSION")
        jika sess_id {
            sess_bersih = sess_id.strip()
            jika sess_bersih {
                kembalikan sess_bersih
            }
        }
        kembalikan kosong
    }

    fungsi simpan_sesi_aktif_id(session_id) {
        """Menyimpan ID sesi aktif terakhir."""
        sess_bersih = session_id.strip()
        set_key(str(diri.env_path), "GEMINI_ACTIVE_SESSION", sess_bersih)
        os.environ["GEMINI_ACTIVE_SESSION"] = sess_bersih
    }

    fungsi apakah_mode_debug() {
        """Memeriksa apakah mode debug aktif via GEMINI_AGENT_DEBUG."""
        kembalikan os.environ.get("GEMINI_AGENT_DEBUG", "0").strip() == "1"
    }

    fungsi ambil_telegram_token() {
        """Mengambil bot token Telegram dari berkas konfigurasi .env."""
        diri.muat_ulang()
        kembalikan os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
    }

    fungsi ambil_telegram_allowed_user_id() {
        """Mengambil User ID Telegram pemilik yang diizinkan mengontrol laptop."""
        diri.muat_ulang()
        kembalikan os.environ.get("TELEGRAM_ALLOWED_USER_ID", "").strip()
    }
}

pengelola_konfigurasi = PengelolaKonfigurasi()
# Alias kompatibilitas
config_manager = pengelola_konfigurasi
