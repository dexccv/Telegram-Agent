    }
}

kontrol_media_browser = control_browser_media


fungsi set_volume(level: str = "status") -> str {
    """Mengatur volume suara master laptop (0-100%, +10, -10, mute, unmute, status).

    Args:
        level: Persentase angka (misal '50', '80%'), relatif ('+10', '-10'), 'mute', 'unmute', atau 'status'.

    Returns:
        Pesan status hasil pengaturan volume laptop.
    """
    coba {
        dari pycaw.pycaw impor AudioUtilities
        speakers = AudioUtilities.GetSpeakers()
        vol = speakers.EndpointVolume

        arg = str(level).strip().lower().replace("%", "")
        jika arg dalam ["mute", "senyap", "bisu", "mati"] {
            vol.SetMute(1, kosong)
            pesan = "🔇 Audio laptop berhasil di-mute (senyap)."
            agent_logger.log_info("perkakas.set_volume", pesan)
            kembalikan pesan
        } jika_lain arg dalam ["unmute", "nyala", "hidup", "suara"] {
            vol.SetMute(0, kosong)
            current = round(vol.GetMasterVolumeLevelScalar() * 100)
            pesan = f"🔊 Audio laptop berhasil di-unmute. Volume saat ini: {current}%"
            agent_logger.log_info("perkakas.set_volume", pesan)
            kembalikan pesan
        } jika_lain arg.startswith("+") atau arg.startswith("-") {
            diff = int(arg)
            current = round(vol.GetMasterVolumeLevelScalar() * 100)
            target = max(0, min(100, current + diff))
            vol.SetMasterVolumeLevelScalar(target / 100.0, kosong)
            vol.SetMute(0, kosong)
            pesan = f"🔊 Volume laptop diubah dari {current}% menjadi {target}%"
            agent_logger.log_info("perkakas.set_volume", pesan)
            kembalikan pesan
        } jika_lain arg.isdigit() {
            target = max(0, min(100, int(arg)))
            vol.SetMasterVolumeLevelScalar(target / 100.0, kosong)
            vol.SetMute(0, kosong)
            pesan = f"🔊 Volume laptop berhasil diatur ke {target}%"
            agent_logger.log_info("perkakas.set_volume", pesan)
            kembalikan pesan
        } selain {
            current = round(vol.GetMasterVolumeLevelScalar() * 100)
            is_muted = vol.GetMute()
            status = "Muted (Senyap) 🔇" jika is_muted selain f"{current}% 🔊"
            kembalikan f"🔊 Volume laptop saat ini: {status}"
        }
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.set_volume", f"Gagal atur volume: {exc}")
        kembalikan f"[GAGAL] Gagal mengatur volume laptop: {exc}"
    }
}

atur_volume = set_volume


fungsi media_control(action: str = "play_pause") -> str {
    """Mengendalikan pemutar media laptop (Play/Pause, Next Track, Previous Track, Stop) untuk YouTube, Spotify, dll.

    Mengirimkan simulasi penekanan tombol fisik keyboard laptop (F10 untuk Play/Pause, F11 untuk Next, F9 untuk Prev)
    beserta sinyal tombol multimedia standar Windows dengan scan code perangkat keras.

    Args:
        action: 'play_pause', 'play', 'pause', 'next', 'prev', 'previous', atau 'stop'.

    Returns:
        Pesan konfirmasi hasil pengendalian pemutar media.
    """
    coba {
        impor ctypes
        impor time

        user32 = ctypes.windll.user32

        VK_F9 = 0x78   # Previous Track di keyboard laptop
        VK_F10 = 0x79  # Play / Pause di keyboard laptop
        VK_F11 = 0x7A  # Next Track di keyboard laptop

        VK_MEDIA_NEXT_TRACK = 0xB0
        VK_MEDIA_PREV_TRACK = 0xB1
        VK_MEDIA_STOP = 0xB2
        VK_MEDIA_PLAY_PAUSE = 0xB3

        KEYEVENTF_EXTENDEDKEY = 0x0001
        KEYEVENTF_KEYUP = 0x0002

        act = str(action).strip().lower()
        fk = kosong
        mk = kosong
        deskripsi = ""

        jika act dalam ["play", "pause", "play_pause", "jeda", "putar", "lanjut"] {
            fk = VK_F10
            mk = VK_MEDIA_PLAY_PAUSE
            deskripsi = "⏯️ Play / Pause (F10) telah ditekan di laptop (YouTube / Spotify)."
        } jika_lain act dalam ["next", "berikutnya", "lanjut_lagu", "next_track"] {
            fk = VK_F11
            mk = VK_MEDIA_NEXT_TRACK
            deskripsi = "⏭️ Lagu berikutnya (Next Track / F11) telah ditekan."
        } jika_lain act dalam ["prev", "previous", "sebelumnya", "prev_track"] {
            fk = VK_F9
            mk = VK_MEDIA_PREV_TRACK
            deskripsi = "⏮️ Lagu sebelumnya (Previous Track / F9) telah ditekan."
        } jika_lain act dalam ["stop", "berhenti"] {
            mk = VK_MEDIA_STOP
            deskripsi = "⏹️ Pemutaran media telah dihentikan."
        } selain {
            fk = VK_F10
            mk = VK_MEDIA_PLAY_PAUSE
            deskripsi = "⏯️ Play / Pause (F10) telah ditekan di laptop."
        }

        # 1. Simulasikan tombol F-Key (F9, F10, atau F11) dengan hardware scan code
        jika fk {
            scan_f = user32.MapVirtualKeyW(fk, 0)
            user32.keybd_event(fk, scan_f, 0, 0)
            time.sleep(0.04)
            user32.keybd_event(fk, scan_f, KEYEVENTF_KEYUP, 0)
        }

        time.sleep(0.02)

        # 2. Simulasikan tombol multimedia Windows standar dengan flag EXTENDEDKEY
        jika mk {
            scan_m = user32.MapVirtualKeyW(mk, 0)
            user32.keybd_event(mk, scan_m, KEYEVENTF_EXTENDEDKEY, 0)
            time.sleep(0.04)
            user32.keybd_event(mk, scan_m, KEYEVENTF_EXTENDEDKEY | KEYEVENTF_KEYUP, 0)
        }

        agent_logger.log_info("perkakas.media_control", deskripsi)
        kembalikan deskripsi
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.media_control", f"Gagal kontrol media: {exc}")
        kembalikan f"[GAGAL] Gagal mengontrol pemutar media: {exc}"
    }
}

kontrol_media = media_control


fungsi create_pdf(filename: str, content: str, title: str = "") -> str {
    """Membuat file dokumen PDF profesional dari teks/konten dan menyimpannya di laptop."""
    coba {
        impor os
        dari pathlib impor Path
        
        target_name = filename.strip() jika filename dan filename.strip() selain "dokumen.pdf"
        jika tidak target_name.lower().endswith(".pdf") {
            target_name += ".pdf"
        }
        target_path = Path(target_name).expanduser().resolve()
        
        dari reportlab.lib.pagesizes impor A4
        dari reportlab.platypus impor SimpleDocTemplate, Paragraph, Spacer
        dari reportlab.lib.styles impor getSampleStyleSheet, ParagraphStyle
        dari reportlab.lib impor colors

        doc = SimpleDocTemplate(
            str(target_path),
            pagesize=A4,
            rightMargin=54,
            leftMargin=54,
            topMargin=54,
            bottomMargin=54,
        )
        
        styles = getSampleStyleSheet()
        normal_style = styles["Normal"]
        normal_style.fontSize = 11
        normal_style.leading = 16
        normal_style.textColor = colors.HexColor("#222222")

        elements = []
        
        doc_title = title.strip() jika title dan title.strip() selain target_path.stem.replace("_", " ").title()
        title_style = ParagraphStyle(
            "DocTitle",
            parent=styles["Heading1"],
            fontSize=18,
            leading=22,
            textColor=colors.HexColor("#1A365D"),
            spaceAfter=15,
        )
        elements.append(Paragraph(doc_title, title_style))
        elements.append(Spacer(1, 10))

        paragraphs = content.strip().split("\n\n")
        untuk p dalam paragraphs {
            p_clean = p.strip()
            jika tidak p_clean {
                lanjut
            }
            p_formatted = p_clean.replace("\n", "<br/>")
            elements.append(Paragraph(p_formatted, normal_style))
            elements.append(Spacer(1, 10))
        }

        doc.build(elements)
        file_size = target_path.stat().st_size
        
        pesan = f"[SUKSES] Dokumen PDF berhasil dibuat di: {target_path} (Ukuran: {file_size:,} byte)\n[BERKAS_SIAP_KIRIM: {target_path}]"
        agent_logger.log_info("perkakas.create_pdf", pesan)
        kembalikan pesan
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.create_pdf", f"Gagal membuat PDF: {exc}")
        kembalikan f"[GAGAL] Gagal membuat dokumen PDF: {exc}"
    }
}

buat_pdf = create_pdf


fungsi send_file_to_user(file_path: str, caption: str = "") -> str {
    """Menyiapkan dan menandai berkas di laptop untuk dikirimkan langsung ke Telegram pengguna."""
    coba {
        impor os
        dari pathlib impor Path
        
        p = Path(file_path.strip()).expanduser().resolve()
        jika tidak p.exists() {
            alt = (Path.cwd() / file_path.strip()).resolve()
            jika alt.exists() {
                p = alt
            }
        }
        jika tidak p.exists() {
            kembalikan f"[GAGAL] Berkas '{file_path}' tidak ditemukan di laptop."
        }
        jika tidak p.is_file() {
            kembalikan f"[GAGAL] Jalur '{file_path}' adalah folder, bukan berkas."
        }
        
        size = p.stat().st_size
        pesan = f"[SUKSES] Berkas siap dikirim ke Telegram: {p} ({size:,} byte)\n[BERKAS_SIAP_KIRIM: {p}]"
        agent_logger.log_info("perkakas.send_file_to_user", pesan)
        kembalikan pesan
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.send_file_to_user", f"Gagal memproses berkas: {exc}")
        kembalikan f"[GAGAL] Gagal memproses berkas: {exc}"
    }
}

kirim_berkas_ke_pengguna = send_file_to_user


fungsi lock_laptop() -> str {
    """Mengunci layar Windows / Workstation laptop seketika (setara pintasan Ctrl + L / Win + L)."""
    coba {
        impor ctypes
        user32 = ctypes.windll.user32
        res = user32.LockWorkStation()
        jika res {
            pesan = "[SUKSES] Layar laptop berhasil dikunci 🔒 (Lock Workstation aktif)."
            agent_logger.log_info("perkakas.lock_laptop", pesan)
            kembalikan pesan
        } selain {
            kembalikan "[GAGAL] Gagal mengunci workstation laptop."
        }
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.lock_laptop", f"Gagal mengunci laptop: {exc}")
        kembalikan f"[GAGAL] Gagal mengunci laptop: {exc}"
    }
}

fungsi restart_all_engines() -> str {
    """Merestart seluruh engine TeleAgent (Ollama Server, Telegram Gateway, Chat Agent) dan mengirimkan checklist ke Telegram."""
    coba {
        import subprocess
        restarter = Path("system_restart.py").resolve()
        jika restarter.exists() {
            subprocess.Popen(
                [sys.executable, str(restarter)],
                creationflags=getattr(subprocess, "DETACHED_PROCESS", 0) | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0),
                close_fds=benar,
            )
            kembalikan "Siklus restart seluruh engine TeleAgent (Ollama, Telegram, Chat Agent) telah dimulai. Sistem akan melakukan verifikasi dan mengirimkan checklist ke Telegram."
        }
        kembalikan "Berkas system_restart.py tidak ditemukan."
    } kecuali Exception sebagai exc {
        kembalikan f"Gagal merestart engine: {exc}"
    }
}

kunci_laptop = lock_laptop
kunci_layar = lock_laptop
lock_screen = lock_laptop
restart_semua_engine = restart_all_engines


