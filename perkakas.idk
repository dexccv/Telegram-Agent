# ==============================================================================
# Modul Perkakas / Tools Sistem (perkakas.idk)
# Bahasa Pemrograman: Indonesiaku-Lang
# ==============================================================================

impor os
impor re
impor subprocess
dari pathlib impor Path
dari typing impor Any

dari logger impor agent_logger
dari memori impor pengelola_memori


# Pola perintah berbahaya yang diblokir untuk keamanan sistem
POLA_BERBAHAYA = [
    r"\brm\s+-(?:r[fv]|f[rv]|rf|fr)\s+(?:/|[a-zA-Z]:\\|\*)",
    r"\bformat\s+[a-zA-Z]:",
    r"\bmkfs\b",
    r"\bshutdown\b",
    r"\bdel\s+(?:/[a-zA-Z\s]+)*[a-zA-Z]:\\",
    r"\brmdir\s+/[sS]\s+/[qQ]\s+[a-zA-Z]:\\",
    r":\(\)\s*\{\s*:\s*\|\s*:\s*&\s*\}\s*;\s*:",  # Fork bomb
    r"\bdd\s+if=.*of=/dev/[sh]d[a-z]",
]


fungsi apakah_perintah_aman(perintah) {
    """Memeriksa apakah perintah terminal masuk dalam daftar hitam perintah berbahaya."""
    perintah_bersih = perintah.strip().lower()

    kata_kunci_terlarang = [
        "rm -rf /",
        "format c:",
        "mkfs",
        "shutdown",
        "del /f /s /q c:\\",
    ]
    untuk k dalam kata_kunci_terlarang {
        jika k dalam perintah_bersih {
            kembalikan (salah, f"Perintah terdeteksi dalam daftar terlarang: '{k}'")
        }
    }

    untuk pola dalam POLA_BERBAHAYA {
        jika re.search(pola, perintah_bersih, re.IGNORECASE) {
            kembalikan (salah, f"Pola berbahaya terdeteksi oleh filter keamanan ({pola}).")
        }
    }

    kembalikan (benar, "")
}

fungsi is_command_safe(perintah) {
    kembalikan apakah_perintah_aman(perintah)
}


fungsi validasi_jalur_sandbox(path: str) {
    """Memvalidasi path berkas yang diminta pengguna secara aman."""
    coba {
        target = Path(path).expanduser().resolve()
        target_str = str(target).lower()

        # Lindungi direktori sistem inti Windows dari operasi berbahaya
        direktori_terlarang = [
            r"c:\windows\system32",
            r"c:\windows\syswow64",
        ]
        untuk d dalam direktori_terlarang {
            jika target_str.startswith(d) {
                alasan = f"Akses diblokir demi keamanan stabilitas OS. Jalur '{target}' berada di area sistem Windows."
                kembalikan (salah, target, alasan)
            }
        }
        kembalikan (benar, target, "")
    } kecuali exc {
        kembalikan (salah, kosong, f"Jalur tidak valid: {exc}")
    }
}


fungsi create_folder(path: str) -> str {
    """Membuat direktori baru pada path yang ditentukan di dalam proyek.

    Args:
        path: Path direktori yang akan dibuat.

    Returns:
        Pesan status hasil pembuatan direktori.
    """
    aman, target, alasan = validasi_jalur_sandbox(path)
    jika tidak aman {
        agent_logger.log_warning("perkakas.create_folder", f"Akses sandbox ditolak: {alasan}")
        kembalikan f"[DIBLOKIR KEAMANAN] {alasan}"
    }

    coba {
        target.mkdir(parents=benar, exist_ok=benar)
        pesan = f"[SUKSES] Direktori berhasil dibuat: {target}"
        agent_logger.log_info("perkakas.create_folder", pesan)
        kembalikan pesan
    } kecuali exc {
        agent_logger.log_error("perkakas.create_folder", f"Gagal membuat folder {path}: {exc}")
        kembalikan f"[GAGAL] Gagal membuat folder '{path}': {exc}"
    }
}

buat_folder = create_folder


fungsi list_files(path: str = ".") -> str {
    """Mendaftar file dan direktori pada path yang diberikan di dalam proyek.

    Args:
        path: Direktori yang ingin diperiksa (default: ".").

    Returns:
        Daftar file dan folder terformat.
    """
    aman, target, alasan = validasi_jalur_sandbox(path)
    jika tidak aman {
        agent_logger.log_warning("perkakas.list_files", f"Akses sandbox ditolak: {alasan}")
        kembalikan f"[DIBLOKIR KEAMANAN] {alasan}"
    }

    coba {
        jika tidak target.exists() {
            kembalikan f"[GAGAL] Jalur tidak ditemukan: {target}"
        }
        jika tidak target.is_dir() {
            kembalikan f"[GAGAL] Jalur bukan sebuah direktori: {target}"
        }

        fungsi _kunci_urut_berkas(p) { kembalikan (tidak p.is_dir(), p.name.lower()) }
        entri = sorted(target.iterdir(), key=_kunci_urut_berkas)
        baris = [f"Isi dari direktori: {target}", "─" * 45]

        jika tidak entri {
            baris.append("  (Direktori kosong)")
        } selain {
            untuk item dalam entri {
                jika item.is_dir() {
                    baris.append(f"  [DIR]   {item.name}/")
                } selain {
                    coba {
                        ukuran = item.stat().st_size
                        jika ukuran < 1024 {
                            str_ukuran = f"{ukuran} B"
                        } jika_lain ukuran < 1024 * 1024 {
                            str_ukuran = f"{ukuran / 1024:.1f} KB"
                        } selain {
                            str_ukuran = f"{ukuran / (1024 * 1024):.1f} MB"
                        }
                    } kecuali exc {
                        str_ukuran = "? B"
                    }
                    baris.append(f"  [FILE]  {item.name:<25} ({str_ukuran})")
                }
            }
        }

        hasil = "\n".join(baris)
        agent_logger.log_info("perkakas.list_files", f"Memindai direktori {target} ({len(entri)} item)")
        kembalikan hasil
    } kecuali exc {
        agent_logger.log_error("perkakas.list_files", f"Gagal mendaftar direktori {path}: {exc}")
        kembalikan f"[GAGAL] Gagal mendaftar direktori '{path}': {exc}"
    }
}

daftar_berkas = list_files


fungsi read_file(path: str) -> str {
    """Membaca isi konten dari file teks lokal di dalam proyek.

    Args:
        path: Path file yang ingin dibaca.

    Returns:
        Konten isi file atau pesan error.
    """
    aman, target, alasan = validasi_jalur_sandbox(path)
    jika tidak aman {
        agent_logger.log_warning("perkakas.read_file", f"Akses sandbox ditolak: {alasan}")
        kembalikan f"[DIBLOKIR KEAMANAN] {alasan}"
    }

    coba {
        jika tidak target.exists() {
            kembalikan f"[GAGAL] Berkas tidak ditemukan: {target}"
        }
        jika target.is_dir() {
            kembalikan f"[GAGAL] Jalur adalah direktori, bukan berkas teks: {target}"
        }

        ukuran = target.stat().st_size
        batas_maks = 1024 * 1024  # 1 MB
        jika ukuran > batas_maks {
            kembalikan f"[GAGAL] Ukuran berkas terlalu besar ({ukuran / 1024:.1f} KB). Batas maksimum adalah 1 MB."
        }

        konten = target.read_text(encoding="utf-8", errors="replace")
        agent_logger.log_info("perkakas.read_file", f"Membaca berkas {target} ({len(konten)} karakter)")
        kembalikan f"[KONTEN BERKAS: {target}]\n" + ("─" * 45) + f"\n{konten}"
    } kecuali exc {
        agent_logger.log_error("perkakas.read_file", f"Gagal membaca berkas {path}: {exc}")
        kembalikan f"[GAGAL] Kesalahan saat membaca berkas '{path}': {exc}"
    }
}

baca_berkas = read_file


fungsi write_file(path: str, content: str) -> str {
    """Menulis atau menimpa konten teks ke file lokal secara aman dan atomik.

    Args:
        path: Path tujuan file yang akan ditulis.
        content: Teks isi file yang akan disimpan.

    Returns:
        Pesan status keberhasilan penulisan file.
    """
    aman, target, alasan = validasi_jalur_sandbox(path)
    jika tidak aman {
        agent_logger.log_warning("perkakas.write_file", f"Akses sandbox ditolak: {alasan}")
        kembalikan f"[DIBLOKIR KEAMANAN] {alasan}"
    }

    coba {
        target.parent.mkdir(parents=benar, exist_ok=benar)
        tmp_file = target.with_suffix(f"{target.suffix}.tmp")
        tmp_file.write_text(content, encoding="utf-8")
        tmp_file.replace(target)
        pesan = f"[SUKSES] Berkas berhasil ditulis ({len(content)} karakter): {target}"
        agent_logger.log_info("perkakas.write_file", pesan)
        kembalikan pesan
    } kecuali exc {
        agent_logger.log_error("perkakas.write_file", f"Gagal menulis ke berkas {path}: {exc}")
        kembalikan f"[GAGAL] Gagal menulis ke berkas '{path}': {exc}"
    }
}

tulis_berkas = write_file


fungsi edit_file(path: str, target_text: str, replacement_text: str) -> str {
    """Mengganti potongan teks tertentu pada file secara presisi (diff replace).

    Args:
        path: Path file yang ingin disunting.
        target_text: Potongan teks yang persis ingin diganti.
        replacement_text: Teks pengganti baru.

    Returns:
        Pesan status keberhasilan atau kegagalan penyuntingan.
    """
    aman, target, alasan = validasi_jalur_sandbox(path)
    jika tidak aman {
        agent_logger.log_warning("perkakas.edit_file", f"Akses sandbox ditolak: {alasan}")
        kembalikan f"[DIBLOKIR KEAMANAN] {alasan}"
    }

    coba {
        jika tidak target.exists() {
            kembalikan f"[GAGAL] Berkas tidak ditemukan: {target}"
        }
        jika target.is_dir() {
            kembalikan f"[GAGAL] Jalur adalah direktori, bukan berkas teks: {target}"
        }

        konten = target.read_text(encoding="utf-8")
        jika target_text tidak dalam konten {
            kembalikan f"[GAGAL] Teks target tidak ditemukan di dalam berkas '{path}'."
        }
        jumlah_kemunculan = konten.count(target_text)
        jika jumlah_kemunculan > 1 {
            kembalikan f"[GAGAL] Teks target muncul sebanyak {jumlah_kemunculan} kali. Mohon sertakan baris konteks sebelum/sesudah agar unik."
        }

        konten_baru = konten.replace(target_text, replacement_text, 1)
        tmp_file = target.with_suffix(f"{target.suffix}.tmp")
        tmp_file.write_text(konten_baru, encoding="utf-8")
        tmp_file.replace(target)

        pesan = f"[SUKSES] Berkas '{target.name}' berhasil disunting secara presisi."
        agent_logger.log_info("perkakas.edit_file", pesan)
        kembalikan pesan
    } kecuali exc {
        agent_logger.log_error("perkakas.edit_file", f"Gagal menyunting berkas {path}: {exc}")
        kembalikan f"[GAGAL] Kesalahan saat menyunting berkas '{path}': {exc}"
    }
}

edit_berkas = edit_file


fungsi run_command(command: str) -> str {
    """Menjalankan perintah shell atau command line pada sistem operasi lokal.

    Args:
        command: Perintah shell yang ingin dieksekusi.

    Returns:
        Output stdout/stderr perintah atau pesan penolakan keamanan.
    """
    aman, alasan = apakah_perintah_aman(command)
    jika tidak aman {
        pesan_blokir = f"[DIBLOKIR KEAMANAN] Perintah dibatalkan: {alasan}"
        agent_logger.log_warning("perkakas.run_command", pesan_blokir)
        kembalikan pesan_blokir
    }

    coba {
        agent_logger.log_info("perkakas.run_command", f"Menjalankan perintah: {command}")
        proses = subprocess.run(
            command,
            shell=benar,
            capture_output=benar,
            text=benar,
            timeout=60,
        )

        stdout = proses.stdout.strip()
        stderr = proses.stderr.strip()
        kode = proses.returncode

        bagian = [f"[KODE KELUAR: {kode}]"]
        jika stdout {
            bagian.append(f"STDOUT:\n{stdout}")
        }
        jika stderr {
            bagian.append(f"STDERR:\n{stderr}")
        }
        jika tidak stdout dan tidak stderr {
            bagian.append("(Tidak ada output)")
        }

        hasil = "\n\n".join(bagian)
        agent_logger.log_info("perkakas.run_command", f"Selesai (kode {kode}): {command[:60]}")
        kembalikan hasil
    } kecuali subprocess.TimeoutExpired {
        agent_logger.log_error("perkakas.run_command", f"Timeout 60 detik pada perintah: {command}")
        kembalikan "[TIMEOUT] Eksekusi perintah melebihi batas waktu 60 detik."
    } kecuali exc {
        agent_logger.log_error("perkakas.run_command", f"Kesalahan saat menjalankan '{command}': {exc}")
        kembalikan f"[GAGAL] Kesalahan saat menjalankan perintah: {exc}"
    }
}

jalankan_perintah = run_command


fungsi save_memory(key: str, value: str) -> str {
    """Menyimpan atau memperbarui informasi penting ke memori jangka panjang.

    Args:
        key: Kunci atau label topik memori (contoh: 'nama_pengguna', 'preferensi').
        value: Nilai fakta atau preferensi yang ingin disimpan.

    Returns:
        Konfirmasi penyimpanan memori.
    """
    coba {
        pengelola_memori.simpan(key, value)
        kembalikan f"[SUKSES] Informasi '{key}' berhasil disimpan ke memori jangka panjang."
    } kecuali exc {
        kembalikan f"[GAGAL] Gagal menyimpan memori: {exc}"
    }
}

simpan_memori = save_memory


fungsi recall_memory(key: str) -> str {
    """Mengingat kembali fakta atau informasi spesifik dari memori jangka panjang.

    Args:
        key: Kunci memori yang ingin dicari.

    Returns:
        Informasi yang tersimpan atau pesan bahwa kunci tidak ditemukan.
    """
    val = pengelola_memori.ambil(key)
    jika val tidak kosong {
        kembalikan f"[DITEMUKAN] {key}: {val}"
    }
    kembalikan f"[TIDAK DITEMUKAN] Tidak ada catatan untuk kunci: '{key}'"
}

ingat_memori = recall_memory


fungsi list_memories() -> str {
    """Melihat daftar seluruh fakta dan preferensi yang tersimpan di memori.

    Returns:
        Daftar seluruh memori atau pesan jika memori masih kosong.
    """
    mems = pengelola_memori.ambil_semua()
    jika tidak mems {
        kembalikan "Memori jangka panjang masih kosong."
    }
    baris = ["Daftar Memori Jangka Panjang Persisten:", "─" * 45]
    untuk k, v dalam mems.items() {
        baris.append(f"• {k}: {v}")
    }
    kembalikan "\n".join(baris)
}

daftar_memori = list_memories


fungsi close_application(app_name_or_pid: str) -> str {
    """Menutup atau menghentikan aplikasi/proses yang sedang berjalan di laptop.

    Args:
        app_name_or_pid: Nama proses (misal: 'chrome.exe', 'notepad', 'msedge') atau PID angka.

    Returns:
        Pesan status hasil penutupan aplikasi.
    """
    nama_target = app_name_or_pid.strip().lower()
    jika tidak nama_target {
        kembalikan "[GAGAL] Nama aplikasi atau PID tidak boleh kosong."
    }

    proses_terlarang = ["csrss.exe", "smss.exe", "wininit.exe", "services.exe", "lsass.exe", "svchost.exe"]
    jika nama_target dalam proses_terlarang atau f"{nama_target}.exe" dalam proses_terlarang {
        kembalikan f"[DIBLOKIR] Menutup proses sistem vital '{nama_target}' tidak diizinkan."
    }

    ditutup = []
    coba {
        impor psutil
        jika nama_target.isdigit() {
            pid = int(nama_target)
            proc = psutil.Process(pid)
            p_name = proc.name()
            proc.terminate()
            ditutup.append(f"{p_name} (PID: {pid})")
        } selain {
            ext_target = nama_target jika nama_target.endswith(".exe") selain f"{nama_target}.exe"
            untuk p dalam psutil.process_iter(["pid", "name"]) {
                coba {
                    p_name = (p.info.get("name") atau "").lower()
                    jika p_name == nama_target atau p_name == ext_target atau (nama_target dalam p_name dan len(nama_target) >= 4) {
                        p.terminate()
                        ditutup.append(f"{p.info['name']} (PID: {p.info['pid']})")
                    }
                } kecuali Exception {
                    lewati
                }
            }
        }

        jika ditutup {
            pesan = f"[SUKSES] Berhasil menutup aplikasi: {', '.join(ditutup[:5])}"
            agent_logger.log_info("perkakas.close_application", pesan)
            kembalikan pesan
        } selain {
            kembalikan f"[INFO] Tidak ditemukan aplikasi yang berjalan dengan nama atau PID '{app_name_or_pid}'."
        }
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.close_application", f"Gagal menutup {app_name_or_pid}: {exc}")
        kembalikan f"[GAGAL] Gagal menutup aplikasi '{app_name_or_pid}': {exc}"
    }
}

tutup_aplikasi = close_application


fungsi capture_camera(output_path: str = "kamera_capture.jpg") -> str {
    """Membuka kamera webcam laptop dan mengambil satu foto.

    Args:
        output_path: Nama berkas foto hasil jepretan (default: kamera_capture.jpg).

    Returns:
        Pesan status hasil pemotretan kamera.
    """
    coba {
        impor cv2
        cap = cv2.VideoCapture(0)
        jika tidak cap.isOpened() {
            kembalikan "[GAGAL] Kamera webcam laptop tidak dapat dibuka atau sedang digunakan oleh aplikasi lain."
        }

        ret = salah
        frame = kosong
        untuk _ dalam range(5) {
            ret, frame = cap.read()
        }
        cap.release()

        jika ret dan frame is not None {
            target = Path(output_path).resolve()
            cv2.imwrite(str(target), frame)
            pesan = f"[SUKSES] Foto webcam berhasil diambil dan disimpan di: {target}"
            agent_logger.log_info("perkakas.capture_camera", pesan)
            kembalikan pesan
        } selain {
            kembalikan "[GAGAL] Gagal membaca gambar dari sensor webcam laptop."
        }
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.capture_camera", f"Error webcam: {exc}")
        kembalikan f"[GAGAL] Kesalahan saat mengakses webcam: {exc}"
    }
}

ambil_foto_kamera = capture_camera


fungsi capture_screen(output_path: str = "screen_capture.png") -> str {
    """Mengambil tangkapan layar (screenshot) display laptop saat ini secara instan.

    Args:
        output_path: Jalur penyimpanan file gambar screenshot (.png atau .jpg).

    Returns:
        Pesan status hasil tangkapan layar laptop.
    """
    coba {
        impor ctypes
        impor os
        impor sys
        impor subprocess
        dari pathlib impor Path
        dari PIL impor ImageGrab

        out_p = Path(output_path).resolve()
        coba {
            jika out_p.exists() {
                out_p.unlink()
            }
        } kecuali Exception {
            lewati
        }

        user32 = ctypes.windll.user32
        user32.OpenInputDesktop.restype = ctypes.c_void_p
        user32.OpenInputDesktop.argtypes = [ctypes.c_uint, ctypes.c_bool, ctypes.c_uint]
        user32.SetThreadDesktop.restype = ctypes.c_bool
        user32.SetThreadDesktop.argtypes = [ctypes.c_void_p]
        user32.CloseDesktop.restype = ctypes.c_bool
        user32.CloseDesktop.argtypes = [ctypes.c_void_p]

        coba {
            hdesk = user32.OpenInputDesktop(0, salah, 0x01FF)
            jika hdesk {
                user32.SetThreadDesktop(hdesk)
            }
        } kecuali Exception {
            lewati
        }

        berhasil = salah

        # Level 1: ImageGrab all_screens
        coba {
            im = ImageGrab.grab(all_screens=benar)
            im.save(str(out_p))
            jika out_p.exists() dan out_p.stat().st_size > 500 {
                berhasil = benar
            }
        } kecuali Exception {
            lewati
        }

        # Level 2: ImageGrab primary screen
        jika tidak berhasil {
            coba {
                im = ImageGrab.grab(all_screens=salah)
                im.save(str(out_p))
                jika out_p.exists() dan out_p.stat().st_size > 500 {
                    berhasil = benar
                }
            } kecuali Exception {
                lewati
            }
        }

        # Level 3: Isolated subprocess worker (fresh GUI thread context)
        jika tidak berhasil {
            coba {
                sub_code = (
                    "import ctypes, sys\n"
                    "user32 = ctypes.windll.user32\n"
                    "user32.OpenInputDesktop.restype = ctypes.c_void_p\n"
                    "user32.OpenInputDesktop.argtypes = [ctypes.c_uint, ctypes.c_bool, ctypes.c_uint]\n"
                    "user32.SetThreadDesktop.restype = ctypes.c_bool\n"
                    "user32.SetThreadDesktop.argtypes = [ctypes.c_void_p]\n"
                    "hdesk = user32.OpenInputDesktop(0, False, 0x01FF)\n"
                    "if hdesk:\n"
                    "    user32.SetThreadDesktop(hdesk)\n"
                    "from PIL import ImageGrab\n"
                    "try:\n"
                    "    im = ImageGrab.grab(all_screens=True)\n"
                    "except Exception:\n"
                    "    im = ImageGrab.grab(all_screens=False)\n"
                    f"im.save(r'{out_p}')\n"
                )
                subprocess.run([sys.executable, "-c", sub_code], capture_output=benar, text=benar, timeout=8)
                jika out_p.exists() dan out_p.stat().st_size > 500 {
                    berhasil = benar
                }
            } kecuali Exception {
                lewati
            }
        }

        jika berhasil {
            agent_logger.log_info("perkakas.capture_screen", f"Screenshot berhasil disimpan: {out_p}")
            kembalikan f"[SUKSES] Tangkapan layar laptop berhasil diambil: {out_p.name}"
        } selain {
            agent_logger.log_error("perkakas.capture_screen", "Gagal tangkap layar: screen grab failed")
            kembalikan "[GAGAL] Gagal mengambil screenshot layar (screen grab failed)."
        }
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.capture_screen", f"Gagal tangkap layar: {exc}")
        kembalikan f"[GAGAL] Gagal mengambil screenshot layar: {exc}"
    }
}

ambil_tangkapan_layar = capture_screen


fungsi get_system_status() -> str {
    """Membaca persentase penggunaan sistem dan penyimpanan laptop secara real-time.

    Returns:
        Informasi real-time penggunaan CPU, RAM, Baterai, Penyimpanan Disk, dan Jendela Aktif.
    """
    coba {
        impor psutil
        impor ctypes

        cpu_pct = psutil.cpu_percent(interval=0.5)
        ram = psutil.virtual_memory()
        ram_str = f"{ram.percent}% (Terpakai: {ram.used // (1024*1024):,} MB / Total: {ram.total // (1024*1024):,} MB)"

        bat = psutil.sensors_battery()
        jika bat {
            bat_status = "Sedang Mengisi Daya (Colok Charger AC)" jika bat.power_plugged selain "Menggunakan Daya Baterai"
            bat_str = f"{bat.percent}% ({bat_status})"
        } selain {
            bat_str = "Tidak terdeteksi / PC Desktop"
        }

        disk_lines = []
        untuk part dalam psutil.disk_partitions(all=salah) {
            coba {
                usage = psutil.disk_usage(part.mountpoint)
                free_gb = usage.free // (1024**3)
                total_gb = usage.total // (1024**3)
                disk_lines.append(f"• Drive {part.device} ({part.mountpoint}): Terpakai {usage.percent}% (Bebas: {free_gb} GB / Total: {total_gb} GB)")
            } kecuali Exception {
                lewati
            }
        }
        disk_str = "\n".join(disk_lines) jika disk_lines selain "Tidak ada info disk"

        hwnd = ctypes.windll.user32.GetForegroundWindow()
        length = ctypes.windll.user32.GetWindowTextLengthW(hwnd)
        buf = ctypes.create_unicode_buffer(length + 1)
        ctypes.windll.user32.GetWindowTextW(hwnd, buf, length + 1)
        win_title = buf.value atau "Desktop / Layar Siaga"

        hasil = (
            "📊 STATUS SISTEM & PENYIMPANAN LAPTOP (REAL-TIME):\n"
            f"• Beban CPU: {cpu_pct}%\n"
            f"• Memori RAM: {ram_str}\n"
            f"• Baterai: {bat_str}\n"
            f"• Jendela Aktif di Layar: {win_title}\n"
            "• Persentase Penyimpanan Disk:\n"
            f"{disk_str}"
        )
        agent_logger.log_info("perkakas.get_system_status", "Berhasil membaca metrik sistem.")
        kembalikan hasil
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.get_system_status", f"Gagal membaca status sistem: {exc}")
        kembalikan f"[GAGAL] Gagal membaca status sistem: {exc}"
    }
}

baca_status_sistem = get_system_status


fungsi check_speed() -> str {
    """Menguji kecepatan jaringan internet, latency API Telegram, latency backend AI, dan responsivitas sistem.

    Returns:
        Laporan diagnostik kecepatan (speed benchmark) secara lengkap.
    """
    coba {
        impor time
        impor urllib.request
        impor psutil
        impor datetime
        dari konfigurasi impor pengelola_konfigurasi

        # 1. Tes Ping ke Server Telegram API
        t0 = time.perf_counter()
        tg_status = "Terhubung"
        tg_ms = 0
        coba {
            req_tg = urllib.request.Request("https://api.telegram.org", headers={"User-Agent": "SpeedTest/1.0"})
            dengan urllib.request.urlopen(req_tg, timeout=4) sebagai _ {
                lewati
            }
            tg_ms = round((time.perf_counter() - t0) * 1000, 1)
        } kecuali Exception sebagai e_tg {
            tg_ms = round((time.perf_counter() - t0) * 1000, 1)
            jika "404" dalam str(e_tg) atau "403" dalam str(e_tg) atau "HTTP" dalam str(e_tg) {
                tg_status = "Terhubung"
            } selain {
                tg_status = f"Lambat ({e_tg})"
            }
        }

        # 2. Tes Ping ke Provider AI Aktif
        prov = pengelola_konfigurasi.ambil_provider()
        ai_ms = 0
        t1 = time.perf_counter()
        jika prov == "ollama" {
            coba {
                req_ol = urllib.request.Request("http://localhost:11434/api/tags", headers={"User-Agent": "SpeedTest/1.0"})
                dengan urllib.request.urlopen(req_ol, timeout=2) sebagai _ {
                    lewati
                }
                ai_ms = round((time.perf_counter() - t1) * 1000, 1)
            } kecuali Exception {
                ai_ms = round((time.perf_counter() - t1) * 1000, 1)
            }
        } jika_lain prov == "omniroute" {
            base_url = pengelola_konfigurasi.ambil_omni_base_url()
            coba {
                req_om = urllib.request.Request(f"{base_url.rstrip('/')}/v1/models", headers={"User-Agent": "SpeedTest/1.0"})
                dengan urllib.request.urlopen(req_om, timeout=3) sebagai _ {
                    lewati
                }
                ai_ms = round((time.perf_counter() - t1) * 1000, 1)
            } kecuali Exception {
                ai_ms = round((time.perf_counter() - t1) * 1000, 1)
            }
        } selain {
            ai_ms = tg_ms
        }

        # 3. Metrik Hardware
        cpu_pct = psutil.cpu_percent(interval=0.2)
        ram = psutil.virtual_memory()

        # Evaluasi Status
        peringkat = "⚡ SANGAT CEPAT" jika tg_ms < 600 selain ("🟢 NORMAL" jika tg_ms < 1500 selain "🟡 CUKUP CEPAT")

        laporan = (
            "⚡ **HASIL UJI KECEPATAN (SPEED BENCHMARK)**\n"
            "━━━━━━━━━━━━━━━━━━━━\n"
            f"🏆 **Performa Umum**: `{peringkat}`\n\n"
            f"📱 **Kecepatan Kirim Telegram**: `{tg_ms} ms` ({tg_status})\n"
            f"🤖 **Latency Engine AI ({prov.upper()})**: `{ai_ms} ms`\n\n"
            f"💻 **Beban Sistem Saat Uji**:\n"
            f"• CPU Load: `{cpu_pct}%`\n"
            f"• RAM Usage: `{ram.percent}% ({ram.used // (1024*1024):,} MB)`\n"
            "━━━━━━━━━━━━━━━━━━━━\n"
            f"_Diuji pada: {datetime.datetime.now().strftime('%H:%M:%S WIB')}_"
        )
        agent_logger.log_info("perkakas.check_speed", f"Hasil speed test: TG={tg_ms}ms, AI={ai_ms}ms")
        kembalikan laporan
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.check_speed", f"Gagal speed test: {exc}")
        kembalikan f"[GAGAL] Gagal menguji kecepatan: {exc}"
    }
}

cek_kecepatan = check_speed


fungsi open_application(app_or_query: str, query: str = "") -> str {
    """Membuka aplikasi desktop, tautan URL, atau membuka Chrome dan mencari di YouTube/Google.

    Args:
        app_or_query: Nama aplikasi (misal: 'chrome', 'notepad', 'calc'), URL, atau instruksi pencarian (misal: 'buka youtube dan cari lagu hindia').
        query: Kata kunci pencarian tambahan jika ada.

    Returns:
        Pesan status hasil pembukaan aplikasi atau pencarian.
    """
    coba {
        impor re
        impor urllib.parse
        impor os
        impor subprocess

        target_clean = app_or_query.strip()
        target_lower = target_clean.lower()

        # Deteksi URL langsung
        jika target_lower.startswith("http://") atau target_lower.startswith("https://") {
            jika "youtube.com" dalam target_lower atau "youtu.be" dalam target_lower {
                kembalikan play_youtube_video(target_clean)
            }
            os.startfile(target_clean)
            agent_logger.log_info("perkakas.open_application", f"Membuka URL: {target_clean}")
            kembalikan f"[SUKSES] Membuka tautan di browser: {target_clean}"
        }

        # Cari path executable Google Chrome
        chrome_candidates = [
            r"C:\Program Files\Google\Chrome\Application\chrome.exe",
            r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe",
            os.path.expandvars(r"%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe"),
        ]
        chrome_exe = kosong
        untuk c dalam chrome_candidates {
            jika os.path.exists(c) {
                chrome_exe = c
                berhenti
            }
        }

        # Deteksi YouTube search (misal: 'buka chrome lalu buka youtube dan cari lagu hindia')
        jika "youtube" dalam target_lower atau "yt" dalam target_lower atau "lagu" dalam target_lower atau "video" dalam target_lower {
            search_term = query.strip()
            jika tidak search_term {
                m = re.search(r"(?:cari|search|lagu|video)\s+(.+)", target_clean, re.IGNORECASE)
                jika m {
                    search_term = m.group(1).strip()
                } selain {
                    cleaned = re.sub(r"\b(buka|open|chrome|lalu|didalam|dan|youtube|yt)\b", "", target_clean, flags=re.IGNORECASE).strip()
                    kata_filler_list = ["coba", "cobain", "tolong", "silakan", "silahkan", "mohon", "harap", "bisa", "bisakah", "dong", "deh", "yuk", "cuy", "bang", "bro", "min", "gan", "ya", "nih", "tuh", "lah", "kah", "saja", "aja", "please", "pls"]
                    untuk fword dalam kata_filler_list {
                        cleaned = re.sub(r"\b" + fword + r"\b", "", cleaned, flags=re.IGNORECASE).strip()
                    }
                    jika cleaned dan len(cleaned) > 1 {
                        search_term = cleaned
                    } selain {
                        search_term = ""
                    }
                }
            }

            jika search_term {
                kembalikan play_youtube_video(search_term)
            } selain {
                kembalikan play_youtube_video("https://www.youtube.com")
            }
        }

        # Deteksi Google Search
        jika "google" dalam target_lower dan ("cari" dalam target_lower atau "search" dalam target_lower) {
            m = re.search(r"(?:cari|search)\s+(.+)", target_clean, re.IGNORECASE)
            search_term = m.group(1).strip() jika m selain query.strip()
            jika search_term {
                g_url = f"https://www.google.com/search?q={urllib.parse.quote_plus(search_term)}"
                jika chrome_exe {
                    subprocess.Popen([chrome_exe, g_url])
                } selain {
                    os.startfile(g_url)
                }
                pesan = f"[SUKSES] Berhasil membuka Google dan mencari: \"{search_term}\""
                agent_logger.log_info("perkakas.open_application", pesan)
                kembalikan pesan
            }
        }

        # Buka aplikasi desktop umum
        app_map = {
            "chrome": chrome_exe atau "chrome",
            "google chrome": chrome_exe atau "chrome",
            "notepad": "notepad.exe",
            "catatan": "notepad.exe",
            "kalkulator": "calc.exe",
            "calc": "calc.exe",
            "calculator": "calc.exe",
            "explorer": "explorer.exe",
            "file explorer": "explorer.exe",
            "cmd": "cmd.exe",
            "terminal": "wt.exe",
            "powershell": "powershell.exe",
            "code": "code",
            "vscode": "code",
            "vs code": "code",
            "spotify": "spotify",
            "edge": "msedge.exe",
            "msedge": "msedge.exe",
        }

        cleaned_app = re.sub(r"^(buka|jalankan|start|open)\s+", "", target_lower).strip()
        cmd_to_run = app_map.get(cleaned_app, cleaned_app)

        jika os.path.exists(cmd_to_run) {
            subprocess.Popen([cmd_to_run])
        } selain {
            os.startfile(cmd_to_run)
        }

        pesan = f"[SUKSES] Berhasil membuka aplikasi: {target_clean}"
        agent_logger.log_info("perkakas.open_application", pesan)
        kembalikan pesan
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.open_application", f"Gagal membuka aplikasi {app_or_query}: {exc}")
        kembalikan f"[GAGAL] Gagal membuka aplikasi '{app_or_query}': {exc}"
    }
}

buka_aplikasi = open_application


fungsi search_youtube_videos(query: str, limit: int = 4) -> list {
    """Mencari video di YouTube dan mengembalikan daftar judul, durasi, channel, dan URL video."""
    coba {
        impor urllib.request
        impor urllib.parse
        impor re
        impor json

        url = f"https://www.youtube.com/results?search_query={urllib.parse.quote_plus(query)}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"})
        html = urllib.request.urlopen(req, timeout=7).read().decode("utf-8", errors="ignore")

        hasil = []
        m = re.search(r"var ytInitialData\s*=\s*({.*?});</script>", html)
        jika m {
            coba {
                data = json.loads(m.group(1))
                contents = data.get("contents", {}).get("twoColumnSearchResultsRenderer", {}).get("primaryContents", {}).get("sectionListRenderer", {}).get("contents", [])
                untuk section dalam contents {
                    items = section.get("itemSectionRenderer", {}).get("contents", [])
                    untuk it dalam items {
                        v = it.get("videoRenderer")
                        jika v dan "videoId" dalam v {
                            vid = v["videoId"]
                            title_runs = v.get("title", {}).get("runs", [])
                            raw_title = "".join(r.get("text", "") untuk r dalam title_runs) jika title_runs selain "Video YouTube"
                            clean_title = re.sub(r"[\u200b-\u200f\ufeff]", "", raw_title).strip()
                            owner_runs = v.get("ownerText", {}).get("runs", [])
                            channel = "".join(r.get("text", "") untuk r dalam owner_runs) jika owner_runs selain ""
                            dur = v.get("lengthText", {}).get("simpleText", "")
                            hasil.append({
                                "video_id": vid,
                                "title": clean_title,
                                "channel": channel,
                                "duration": dur,
                                "url": f"https://www.youtube.com/watch?v={vid}"
                            })
                            jika len(hasil) >= limit {
                                berhenti
                            }
                        }
                    }
                    jika len(hasil) >= limit {
                        berhenti
                    }
                }
            } kecuali Exception {
                lewati
            }
        }

        jika tidak hasil {
            vids = re.findall(r'"videoId":"([a-zA-Z0-9_-]{11})"', html)
            seen = set()
            untuk vid dalam vids {
                jika vid tidak dalam seen dan len(hasil) < limit {
                    seen.add(vid)
                    hasil.append({
                        "video_id": vid,
                        "title": f"YouTube Video ({vid})",
                        "channel": "",
                        "duration": "",
                        "url": f"https://www.youtube.com/watch?v={vid}"
                    })
                }
            }
        }
        kembalikan hasil
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.search_youtube_videos", f"Gagal mencari video YouTube: {exc}")
        kembalikan []
    }
}

cari_video_youtube = search_youtube_videos


fungsi play_youtube_video(video_id_or_url: str) -> str {
    """Membuka video YouTube di browser Chrome dan langsung memutarnya secara otomatis."""
    coba {
        impor os
        impor subprocess
        impor urllib.parse

        target = video_id_or_url.strip()
        jika target.startswith("http://") atau target.startswith("https://") {
            final_url = target
        } selain {
            # Cek apakah target adalah 11-karakter ID YouTube standar tanpa spasi
            is_valid_id = len(target) == 11 dan all([c.isalnum() atau c dalam "_-" untuk c dalam target])
            jika tidak is_valid_id {
                # Cari video teratas menggunakan search_youtube_videos
                hasil_cari = search_youtube_videos(target, limit=1)
                jika hasil_cari dan len(hasil_cari) > 0 {
                    vid_info = hasil_cari[0]
                    v_id = vid_info.get("video_id")
                    final_url = f"https://www.youtube.com/watch?v={v_id}&autoplay=1" jika v_id selain (vid_info.get("url") atau target)
                } selain {
                    encoded = urllib.parse.quote_plus(target)
                    final_url = f"https://www.youtube.com/results?search_query={encoded}"
                }
            } selain {
                final_url = f"https://www.youtube.com/watch?v={target}&autoplay=1"
            }
        }

        # Cek apakah ada tab YouTube yang sudah terbuka di browser (Re-use untuk hemat tab)
        tabs_aktif = get_open_browser_tabs()
        yt_tab = kosong
        untuk t dalam tabs_aktif {
            jika t.get("is_youtube") {
                yt_tab = t
                berhenti
            }
        }

        jika yt_tab {
            coba {
                hwnd = yt_tab["hwnd"]
                tab_idx = yt_tab.get("tab_index", 0)

                impor ctypes
                impor time
                user32 = ctypes.windll.user32
                user32.ShowWindow(hwnd, 9)
                user32.SetForegroundWindow(hwnd)
                time.sleep(0.2)

                coba {
                    impor uiautomation as auto
                    w_ctrl = auto.ControlFromHandle(hwnd)
                    jika w_ctrl {
                        tab_items = []
                        untuk c, d dalam auto.WalkControl(w_ctrl, maxDepth=8) {
                            jika c.ControlType == auto.ControlType.TabItemControl dan c.Name {
                                tab_items.append(c)
                            }
                        }
                        jika 0 <= tab_idx < len(tab_items) {
                            tab_items[tab_idx].Click()
                            time.sleep(0.2)
                        }
                    }
                } kecuali Exception {
                    lewati
                }

                subprocess.run(["clip"], input=final_url.encode("utf-16le"), timeout=3)
                time.sleep(0.15)

                VK_MENU = 0x12  # Tombol Alt (Standar Windows Address Bar)
                VK_D = ord('D')
                VK_CONTROL = 0x11
                KEYEVENTF_KEYUP = 0x0002
                # Kirim Alt + D (Fokus Address Bar browser standar Windows tanpa konflik Ctrl+L)
                user32.keybd_event(VK_MENU, 0, 0, 0)
                user32.keybd_event(VK_D, 0, 0, 0)
                user32.keybd_event(VK_D, 0, KEYEVENTF_KEYUP, 0)
                user32.keybd_event(VK_MENU, 0, KEYEVENTF_KEYUP, 0)
                time.sleep(0.15)

                # Kirim Ctrl + V (Paste URL)
                user32.keybd_event(VK_CONTROL, 0, 0, 0)
                user32.keybd_event(ord('V'), 0, 0, 0)
                user32.keybd_event(ord('V'), 0, KEYEVENTF_KEYUP, 0)
                user32.keybd_event(VK_CONTROL, 0, KEYEVENTF_KEYUP, 0)
                time.sleep(0.15)

                # Kirim Enter
                VK_RETURN = 0x0D
                user32.keybd_event(VK_RETURN, 0, 0, 0)
                user32.keybd_event(VK_RETURN, 0, KEYEVENTF_KEYUP, 0)

                pesan = f"[SUKSES] Menggunakan tab YouTube yang sudah aktif (hemat tab) untuk memutar: {final_url}"
                agent_logger.log_info("perkakas.play_youtube_video", pesan)
                kembalikan pesan
            } kecuali Exception sebagai exc_reuse {
                agent_logger.log_warning("perkakas.play_youtube_video", f"Gagal re-use tab YouTube: {exc_reuse}")
            }
        }

        chrome_candidates = [
            r"C:\Program Files\Google\Chrome\Application\chrome.exe",
            r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe",
            os.path.expandvars(r"%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe"),
        ]
        chrome_exe = kosong
        untuk c dalam chrome_candidates {
            jika os.path.exists(c) {
                chrome_exe = c
                berhenti
            }
        }

        jika chrome_exe {
            subprocess.Popen([chrome_exe, final_url])
        } selain {
            os.startfile(final_url)
        }

        pesan = f"[SUKSES] Membuka dan memutar video di Chrome: {final_url}"
        agent_logger.log_info("perkakas.play_youtube_video", pesan)
        kembalikan pesan
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.play_youtube_video", f"Gagal memutar video: {exc}")
        kembalikan f"[GAGAL] Gagal memutar video YouTube: {exc}"
    }
}

putar_video_youtube = play_youtube_video


fungsi get_open_browser_tabs() -> list {
    """Mendeteksi seluruh jendela dan tab browser aktif di laptop (Chrome, Edge, Firefox, Brave, Opera)."""
    coba {
        impor ctypes
        dari ctypes impor wintypes
        impor psutil

        user32 = ctypes.windll.user32
        browsers = []

        fungsi enum_callback(hwnd, lparam) {
            jika tidak user32.IsWindowVisible(hwnd) {
                kembalikan benar
            }
            length = user32.GetWindowTextLengthW(hwnd)
            jika length <= 0 {
                kembalikan benar
            }
            buff = ctypes.create_unicode_buffer(length + 1)
            user32.GetWindowTextW(hwnd, buff, length + 1)
            title = buff.value.strip()
            jika tidak title {
                kembalikan benar
            }

            pid = wintypes.DWORD()
            user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
            pname = ""
            coba {
                pname = psutil.Process(pid.value).name().lower()
            } kecuali Exception {
                lewati
            }

            browser_exes = ["chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe"]
            is_browser = pname dalam browser_exes atau any(b dalam title.lower() untuk b dalam [" - google chrome", " - microsoft edge", " - edge", " - mozilla firefox", " - brave"])

            jika is_browser {
                tab_ditemukan = []
                coba {
                    impor uiautomation as auto
                    w_ctrl = auto.ControlFromHandle(hwnd)
                    jika w_ctrl {
                        untuk c, d dalam auto.WalkControl(w_ctrl, maxDepth=8) {
                            jika c.ControlType == auto.ControlType.TabItemControl dan c.Name dan c.Name.strip() {
                                tab_ditemukan.append(c.Name.strip())
                            }
                        }
                    }
                } kecuali Exception {
                    lewati
                }

                jika tab_ditemukan {
                    untuk idx, t_name dalam enumerate(tab_ditemukan) {
                        clean_t = t_name
                        untuk sfx dalam [" - Google Chrome", " - Microsoft​ Edge", " - Microsoft Edge", " - Mozilla Firefox", " - Brave"] {
                            clean_t = clean_t.replace(sfx, "")
                        }
                        is_yt = "youtube" dalam t_name.lower() atau "youtu.be" dalam t_name.lower()
                        is_med = is_yt atau any(m dalam t_name.lower() untuk m dalam ["spotify", "music", "audio", "video", "soundcloud"])
                        browsers.append({
                            "hwnd": int(hwnd),
                            "tab_index": idx,
                            "pid": int(pid.value),
                            "process_name": pname,
                            "full_title": t_name,
                            "clean_title": clean_t,
                            "is_youtube": is_yt,
                            "is_media": is_med,
                            "is_individual_tab": benar,
                        })
                    }
                } selain {
                    clean_title = title
                    untuk sfx dalam [" - Google Chrome", " - Microsoft​ Edge", " - Microsoft Edge", " - Mozilla Firefox", " - Brave"] {
                        clean_title = clean_title.replace(sfx, "")
                    }
                    is_youtube = "youtube" dalam title.lower() atau "youtu.be" dalam title.lower()
                    is_media = is_youtube atau any(m dalam title.lower() untuk m dalam ["spotify", "music", "audio", "video", "soundcloud"])

                    browsers.append({
                        "hwnd": int(hwnd),
                        "tab_index": 0,
                        "pid": int(pid.value),
                        "process_name": pname,
                        "full_title": title,
                        "clean_title": clean_title,
                        "is_youtube": is_youtube,
                        "is_media": is_media,
                        "is_individual_tab": salah,
                    })
                }
            }
            kembalikan benar
        }

        WNDENUMPROC = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
        user32.EnumWindows(WNDENUMPROC(enum_callback), 0)
        kembalikan browsers
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.get_open_browser_tabs", f"Gagal membaca tab browser: {exc}")
        kembalikan []
    }
}

ambil_tab_browser = get_open_browser_tabs


fungsi focus_window(hwnd: int, tab_index: int = 0) -> str {
    """Membawa jendela aplikasi atau tab browser tertentu ke layar depan laptop."""
    coba {
        impor ctypes
        impor time
        user32 = ctypes.windll.user32
        user32.ShowWindow(hwnd, 9)
        user32.SetForegroundWindow(hwnd)
        time.sleep(0.15)

        jika tab_index >= 0 {
            coba {
                impor uiautomation as auto
                w_ctrl = auto.ControlFromHandle(hwnd)
                jika w_ctrl {
                    tab_items = []
                    untuk c, d dalam auto.WalkControl(w_ctrl, maxDepth=8) {
                        jika c.ControlType == auto.ControlType.TabItemControl dan c.Name dan c.Name.strip() {
                            tab_items.append(c)
                        }
                    }
                    jika 0 <= tab_index < len(tab_items) {
                        tab_items[tab_index].Click()
                        time.sleep(0.2)
                    }
                }
            } kecuali Exception {
                lewati
            }
        }

        pesan = f"[SUKSES] Jendela (HWND: {hwnd}, Tab: #{tab_index + 1}) berhasil dibawa ke depan."
        agent_logger.log_info("perkakas.focus_window", pesan)
        kembalikan pesan
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.focus_window", f"Gagal fokus jendela: {exc}")
        kembalikan f"[GAGAL] Gagal membawa jendela ke depan: {exc}"
    }
}

fokus_jendela = focus_window


fungsi close_window_tab(hwnd: int, tab_index: int = 0) -> str {
    """Menutup tab tertentu di browser (Ctrl + W) atau menutup jendela jika tab_index tidak dispesifikasikan."""
    coba {
        impor ctypes
        impor time
        user32 = ctypes.windll.user32

        # 1. Bawa jendela ke depan
        user32.ShowWindow(hwnd, 9)
        user32.SetForegroundWindow(hwnd)
        time.sleep(0.15)

        # 2. Jika ada tab_index, klik tab tersebut agar aktif
        coba {
            impor uiautomation as auto
            w_ctrl = auto.ControlFromHandle(hwnd)
            jika w_ctrl {
                tab_items = []
                untuk c, d dalam auto.WalkControl(w_ctrl, maxDepth=8) {
                    jika c.ControlType == auto.ControlType.TabItemControl dan c.Name {
                        tab_items.append(c)
                    }
                }
                jika 0 <= tab_index < len(tab_items) {
                    tab_items[tab_index].Click()
                    time.sleep(0.15)
                }
            }
        } kecuali Exception {
            lewati
        }

        # 3. Kirim Ctrl + W untuk menutup HANYA tab tersebut
        VK_CONTROL = 0x11
        VK_W = ord('W')
        KEYEVENTF_KEYUP = 0x0002
        user32.keybd_event(VK_CONTROL, 0, 0, 0)
        user32.keybd_event(VK_W, 0, 0, 0)
        user32.keybd_event(VK_W, 0, KEYEVENTF_KEYUP, 0)
        user32.keybd_event(VK_CONTROL, 0, KEYEVENTF_KEYUP, 0)

        pesan = f"[SUKSES] Tab #{tab_index + 1} pada jendela (HWND: {hwnd}) berhasil ditutup (Ctrl+W)."
        agent_logger.log_info("perkakas.close_window_tab", pesan)
        kembalikan pesan
    } kecuali Exception sebagai exc {
        agent_logger.log_error("perkakas.close_window_tab", f"Gagal menutup tab: {exc}")
        kembalikan f"[GAGAL] Gagal menutup tab: {exc}"
    }
}

tutup_jendela = close_window_tab


